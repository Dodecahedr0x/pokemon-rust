    "releaseall": Native,
    "release": Native,
    "waitbuttonpress": Native,
    "yesnobox": Native,
    "multichoice": Native,
    "multichoicedefault": Native,
    "multichoicegrid": Default(127),                // VAR_RESULT: MULTI_B_PRESSED
    "drawbox": Ignore,                              // ScrCmd_drawbox does nothing in Emerald
    "erasebox": Ignore,                             // cosmetic window erase
    "drawboxtext": Ignore,                          // cosmetic window
    "showmonpic": Ignore,                           // cosmetic picture window
    "hidemonpic": Ignore,                           // cosmetic picture window
    "showcontestpainting": Unsupported,
    "braillemessage": Unsupported,
    "givemon": Native,
    "giveegg": Default(2),                          // VAR_RESULT: MON_CANT_GIVE, the truth: the egg is not given
    "setmonmove": Unsupported,
    "checkpartymove": Native,                       // Wave C: prelude check_party_move
    "bufferspeciesname": Native,
    "bufferleadmonspeciesname": Native,
    "bufferpartymonnick": Native,
    "bufferitemname": Native,
    "bufferdecorationname": Unsupported,
    "buffermovename": Native,
    "buffernumberstring": Native,
    "bufferstdstring": Native,
    "bufferstring": Native,
    "pokemart": Unsupported,
    "pokemartdecoration": Unsupported,
    "pokemartdecoration2": Unsupported,
    "playslotmachine": Unsupported,
    "setberrytree": Unsupported,
    "choosecontestmon": Unsupported,
    "startcontest": Unsupported,
    "showcontestresults": Unsupported,
    "contestlinktransfer": Unsupported,
    "random": Native,
    "addmoney": Native,
    "removemoney": Native,
    "checkmoney": Native,
    "showmoneybox": Ignore,                         // cosmetic window; money itself is native
    "hidemoneybox": Ignore,                         // cosmetic window; money itself is native
    "updatemoneybox": Ignore,                       // cosmetic window; money itself is native
    "getpokenewsactive": Default(0),                // VAR_RESULT: no PokeNews
    "fadescreen": Native,
    "fadescreenspeed": Native,
    "setflashlevel": Ignore,                        // darkness (Flash) is not drawn
    "animateflash": Ignore,                         // darkness (Flash) is not drawn
    "messageautoscroll": Native,
    "dofieldeffect": Native,
    "setfieldeffectargument": Native,
    "waitfieldeffect": Native,
    "setrespawn": Native,
    "checkplayergender": Native,
    "playmoncry": Ignore,                           // audio (no sound until M12)
    "setmetatile": Native,
    "resetweather": Ignore,                         // weather is not drawn
    "setweather": Ignore,                           // weather is not drawn
    "doweather": Ignore,                            // weather is not drawn
    "setstepcallback": Ignore,                      // GameData::step_callback answers the map's on_resume value (ice, cracked floors); ash, bridges and the truck are not modelled
    "setmaplayoutindex": Native,
    "setobjectsubpriority": Ignore,                 // sprite draw order only
    "resetobjectsubpriority": Ignore,               // sprite draw order only
    "createvobject": Native,
    "turnvobject": Native,
    "opendoor": Native,
    "closedoor": Native,
    "waitdooranim": Native,
    "setdooropen": Unsupported,
    "setdoorclosed": Unsupported,
    "addelevmenuitem": Unsupported,
    "showelevmenu": Unsupported,
    "checkcoins": Default(0),                       // writes its var operand: no coins
    "addcoins": Default(1),                         // VAR_RESULT: TRUE is failure here (coins are not kept)
    "removecoins": Default(1),                      // VAR_RESULT: TRUE is failure here (coins are not kept)
    "setwildbattle": Native,
    "dowildbattle": Native,
    "setvaddress": Unsupported,
    "vgoto": Unsupported,
    "vcall": Unsupported,
    "vgoto_if": Unsupported,
    "vcall_if": Unsupported,
    "vmessage": Unsupported,
    "vbuffermessage": Unsupported,
    "vbufferstring": Unsupported,
    "showcoinsbox": Ignore,                         // cosmetic window (coins are not kept)
    "hidecoinsbox": Ignore,                         // cosmetic window (coins are not kept)
    "updatecoinsbox": Ignore,                       // cosmetic window (coins are not kept)
    "incrementgamestat": Ignore,                    // game stats are not kept (no trainer card)
    "setescapewarp": Native,
    "waitmoncry": Ignore,                           // audio (no sound until M12)
    "bufferboxname": Unsupported,
    "textcolor": Ignore,                            // ScrCmd_nop1 in Emerald
    "loadhelp": Ignore,                             // ScrCmd_nop1 in Emerald
    "unloadhelp": Ignore,                           // ScrCmd_nop1 in Emerald
    "signmsg": Ignore,                              // ScrCmd_nop1 in Emerald

// Script command classes for the Milestone 8 lowering (`extract::codegen::lower`), one entry
// per `data/script_cmd_table.inc` command, keyed by its `asm/macros/event.inc` macro name.
//
// - Native: lowered to engine requests or prelude helpers.
// - Ignore: no effect on the engine's state; nothing is emitted (each has a one-line reason).
// - Default(v): `v` is written where the command writes its result (VAR_RESULT, or
//   `checkcoins`'s var operand), with no report: the default is the documented behaviour.
// - Unsupported: `Report::Unsupported("<op>")`, logged; the script continues and VAR_RESULT is
//   unchanged (other state it would write stays stale, noted where scripts read it). A
//   terminator (`gotopostbattlescript`, `vgoto`, ...) also ends the script.
// Only Unsupported commands report.
//
// Counts: 116 Native, 43 Ignore, 13 Default, 55 Unsupported.
//
// Movement fallbacks are in `movements.ron`. Decomp names and classes only: no ROM data.
{
    "nop": Native,
    "nop1": Native,
    "end": Native,
    "return": Native,
    "call": Native,
    "goto": Native,
    "goto_if": Native,
    "call_if": Native,
    "gotostd": Native,
    "callstd": Native,
    "gotostd_if": Native,
    "callstd_if": Native,
    "returnram": Native,
    "endram": Native,
    "setmysteryeventstatus": Unsupported,
    "loadword": Native,
    "loadbyte": Unsupported,
    "setptr": Unsupported,
    "loadbytefromptr": Unsupported,
    "setptrbyte": Unsupported,
    "copylocal": Unsupported,
    "copybyte": Unsupported,
    "setvar": Native,
    "addvar": Native,
    "subvar": Native,
    "copyvar": Native,
    "setorcopyvar": Native,
    "compare_local_to_local": Unsupported,          // leaves the comparison register stale (no script-local bytes)
    "compare_local_to_value": Unsupported,          // leaves the comparison register stale (no script-local bytes)
    "compare_local_to_ptr": Unsupported,            // leaves the comparison register stale (no RAM pointers)
    "compare_ptr_to_local": Unsupported,            // leaves the comparison register stale (no RAM pointers)
    "compare_ptr_to_value": Unsupported,            // leaves the comparison register stale (no RAM pointers)
    "compare_ptr_to_ptr": Unsupported,              // leaves the comparison register stale (no RAM pointers)
    "compare_var_to_value": Native,
    "compare_var_to_var": Native,
    "callnative": Unsupported,
    "gotonative": Unsupported,
    "special": Native,
    "specialvar": Native,
    "waitstate": Native,
    "delay": Native,
    "setflag": Native,
    "clearflag": Native,
    "checkflag": Native,
    "initclock": Ignore,                            // sets the RTC; there is no clock until M10, time stays the M8 default
    "dotimebasedevents": Ignore,                    // time-based events need the RTC (M10)
    "gettime": Unsupported,                         // leaves VAR_0x8000..VAR_0x8002 (hours, minutes, seconds) stale: no RTC
    "playse": Ignore,                               // audio (no sound until M12)
    "waitse": Ignore,                               // audio (no sound until M12)
    "playfanfare": Ignore,                          // audio (no sound until M12)
    "waitfanfare": Ignore,                          // audio (no sound until M12)
    "playbgm": Ignore,                              // audio (no sound until M12)
    "savebgm": Ignore,                              // audio (no sound until M12)
    "fadedefaultbgm": Ignore,                       // audio (no sound until M12)
    "fadenewbgm": Ignore,                           // audio (no sound until M12)
    "fadeoutbgm": Ignore,                           // audio (no sound until M12)
    "fadeinbgm": Ignore,                            // audio (no sound until M12)
    "warp": Native,
    "warpsilent": Native,
    "warpdoor": Native,
    "warphole": Native,                             // MAP_UNDEFINED: the map's hole warp (GameData::hole_warp)
    "warpteleport": Native,
    "setwarp": Unsupported,                         // the warp destination of warp specials (DoContestHallWarp, ...); no WarpSlot for it
    "setdynamicwarp": Native,
    "setdivewarp": Unsupported,                     // Dive is M9
    "setholewarp": Ignore,                          // GameData::hole_warp answers the map's on_resume value
    "getplayerxy": Native,
    "getpartysize": Native,
    "additem": Native,
    "removeitem": Native,
    "checkitemspace": Native,
    "checkitem": Native,
    "checkitemtype": Native,                        // VAR_RESULT = the item's POCKET_* (Task H)
    "addpcitem": Default(0),                        // VAR_RESULT: the PC has no room (no PC storage until M9)
    "checkpcitem": Default(0),                      // VAR_RESULT: not in the PC
    "adddecoration": Default(0),                    // VAR_RESULT: not added (no decorations)
    "removedecoration": Default(0),                 // VAR_RESULT: not removed
    "checkdecor": Default(0),                       // VAR_RESULT: not owned
    "checkdecorspace": Default(0),                  // VAR_RESULT: no space
    "applymovement": Native,
    "applymovementat": Native,
    "waitmovement": Native,
    "waitmovementat": Native,
    "removeobject": Native,
    "removeobjectat": Native,
    "addobject": Native,
    "addobjectat": Native,
    "setobjectxy": Native,
    "showobjectat": Native,
    "hideobjectat": Native,
    "faceplayer": Native,
    "turnobject": Native,
    "trainerbattle": Native,
    "dotrainerbattle": Unsupported,
    "gotopostbattlescript": Unsupported,
    "gotobeatenscript": Unsupported,
    "checktrainerflag": Native,
    "settrainerflag": Native,
    "cleartrainerflag": Native,
    "setobjectxyperm": Native,
    "copyobjectxytoperm": Native,
    "setobjectmovementtype": Native,
    "waitmessage": Native,

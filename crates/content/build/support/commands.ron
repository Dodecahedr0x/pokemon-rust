    "comparehiddenvar": Ignore,                     // ScrCmd_nop1 in Emerald
    "setmodernfatefulencounter": Native,
    "checkmodernfatefulencounter": Default(0),      // VAR_RESULT: not a fateful encounter
    "trywondercardscript": Native,
    "setworldmapflag": Ignore,                      // ScrCmd_nop1 in Emerald
    "warpspinenter": Native,
    "setmonmetlocation": Unsupported,
    "moverotatingtileobjects": Native, // Wave F: rotating_tile_puzzle.c (Mossdeep gym, Trick House room 7)
    "turnrotatingtileobjects": Native, // Wave F: rotating_tile_puzzle.c (Mossdeep gym, Trick House room 7)
    "initrotatingtilepuzzle": Native, // Wave F: rotating_tile_puzzle.c (Mossdeep gym, Trick House room 7)
    "freerotatingtilepuzzle": Native, // Wave F: rotating_tile_puzzle.c (Mossdeep gym, Trick House room 7)
    "warpmossdeepgym": Native,

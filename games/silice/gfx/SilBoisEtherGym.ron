        ),
        (
            name: "porte_sas_ouverte",
            cells: [".", "."],
            prompt: Some("One single open airlock doorway seen from the front, twice as tall as wide: a grey steel frame with a rounded top, the hatch gone, inside a dark passage with a light honey-coloured wooden floor at the bottom, a small green lamp on top. Only one doorway, nothing else."),
        ),
        (
            name: "verriere",
            cells: ["#", "#"],

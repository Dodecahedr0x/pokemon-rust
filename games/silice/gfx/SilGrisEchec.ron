        ),
        (
            name: "tour",
            cells: ["####", "####", "####", "####", "#DD#"],
            prompt: Some("A tall square security observation tower of raw grey concrete seen from the front: narrow, with a tall thin radio antenna mast with a small red light on top of its flat roof, a band of dark tinted observation windows near the top, a row of small grey surveillance screens showing static, and a wide dark metal double door exactly in the middle of the bottom edge."),
        ),
        (
            name: "annexe",
            cells: ["#####", "#...#", "#...#", "#.###", "#.###"],
            prompt: Some("A low one-storey concrete shop annex seen from above and the front: a large flat grey gravel roof with a low concrete parapet around it occupying the upper three fifths, a plain grey concrete front wall below with one small dark window, and a narrow black iron wall ladder running up the front wall in the second column from the left, from the bottom edge up to the roof."),
        ),
        (
            name: "arene",
            cells: ["#####", "#####", "#####", "#####", "##D##"],
            key: Some("00FF00"),
            prompt: Some("A monolithic black cube building without any window, flat matte black walls with faint dark grey panel seams, a thin white edge on the roof outline, two bright working screens on its facade showing a white chess knight and a chessboard on glowing cyan, and a black double door with a thin cyan frame exactly in the middle of the bottom edge."),
        ),
        (
            name: "usine",

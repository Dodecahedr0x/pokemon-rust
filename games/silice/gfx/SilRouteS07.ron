            cells: ["##", "##"],
        ),
        (
            // A concrete pier under a platform's edge, dropping into the fog (2x2, solid).
            name: "pile",
            cells: ["##", "##"],
            under: Some("vide"),
            prompt: Some("The top of a massive concrete bridge pier seen from above and the front, square: a pale warm grey concrete column with a darker capital at the top, two rusty rebar stubs, its lower half fading into dark indigo fog with a few cyan digit dashes. Bold chunky shapes."),
        ),
        (
            name: "acier",
            cells: ["."],
            key: Some("none"),
            prompt: Some("The deck of a steel bridge seen from straight above, ONE single tile: a flat cold grey steel plate (#8890a0) with a thin darker grey seam along the top and left edges, four tiny dark rivets near the corners, and one faint diagonal scratch. Flat, only 16x16 pixels, chunky."),
        ),
        (
            name: "beton",
            cells: ["."],
            key: Some("none"),
            prompt: Some("Raw concrete platform floor seen from straight above, ONE single tile: a flat pale warm grey concrete slab (#b0aca4) with a thin dark grey joint along the top and left edges, two small darker formwork holes, and one thin crack. Flat, only 16x16 pixels, chunky."),
        ),
        (
            name: "verre",
            cells: ["."],
        ),

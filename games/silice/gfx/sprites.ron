// Original overworld sprites (cargo xtask silice gfx sprites). Characters from
// contenu-jeu/bible/personnages.md. An Emerald name replaces that sprite in Silice (the Magma
// members are only ever Team Cocket's grunts here); a SIL_ name is a new graphics id that maps
// name as OBJ_EVENT_GFX_SIL_<NAME>.
(
    style: "Minimalist 16-bit sprite in the Pokemon Ruby/Emerald overworld style (Game Boy Advance). Simple, iconic, low detail: big flat colour areas, 2-3 shades per colour, a 1-pixel dark outline, no anti-aliasing, no gradients.",
    sprites: [
        (
            name: "MAGMA_MEMBER_M",
            prompt: "A Team Cocket grunt (a man): black suit-like jumpsuit, black cap, white gloves and boots, a red letter-less emblem shaped like a cocktail glass on the chest, thin neon pink and cyan glitch stripes on the sleeves.",
        ),
        (
            name: "MAGMA_MEMBER_F",
            prompt: "A Team Cocket grunt (a woman with a short ponytail): black suit-like jumpsuit with a short skirt, black cap, white gloves and boots, a red letter-less emblem shaped like a cocktail glass on the chest, thin neon pink and cyan glitch stripes on the sleeves.",
        ),
        (
            name: "SIL_ADRIEN",
            gfx_id: Some(0x100),
            prompt: "Adrien, a romantic poet and film buff of about 18: messy brown hair, round glasses, a long beige trench coat over a dark blue sweater, a small notebook in hand.",
        ),
        (
            name: "SIL_GWADA",
            gfx_id: Some(0x101),
            prompt: "Gwada, a mixed-race young man of about 18 with a big afro haircut: bright orange short-sleeved shirt with green palm patterns, khaki shorts, sneakers, confident debater's posture.",
        ),
        (
            name: "SIL_MATHIEU",
            gfx_id: Some(0x102),
            prompt: "Mathieu, a tall broad-shouldered big-hearted young man (a gentle giant comic-book fan): short dark hair, a red scarf knotted at the neck and flowing behind him like a superhero cape, grey t-shirt with a yellow lightning bolt, blue jeans.",
        ),
        (
            name: "SIL_JULIEN",
            gfx_id: Some(0x103),
            prompt: "Julien, a dusty absent-minded traveller, a grown man in his forties with a full brown beard and shaggy shoulder-length hair, a worn olive-green travelling cloak, a big backpack with a rolled blanket, brown boots.",
        ),
        (
            name: "SIL_BENOU",
            gfx_id: Some(0x104),
            prompt: "Benou, a systems architect hacker in his thirties: dark grey hoodie with a cyan circuit pattern, headset around the neck, black cargo pants, a laptop under the arm, short black hair.",
        ),
        (
            name: "SIL_LOIC",
            gfx_id: Some(0x105),
            prompt: "Loic, a 23-year-old forest technician in light techwear: dark green waterproof jacket with purple straps, thick protective gloves, a filter mask hanging at the neck, short brown hair.",
        ),
        // Ch2 (Gris-Échec), ids 0x120..=0x12F.
        (
            name: "SIL_YOHAN",
            gfx_id: Some(0x120),
            prompt: "Yohan, a calm young chess grandmaster and Psychic-type gym leader: neat short black hair, a long black and white checkered coat over a black turtleneck, black trousers, white gloves, hands clasped behind the back.",
        ),
    ],
)

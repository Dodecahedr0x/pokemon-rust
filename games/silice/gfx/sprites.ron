        // Ch7 (Reverse-City), ids 0x170..=0x17F.
        (
            name: "SIL_REVERSE",
            gfx_id: Some(0x170),
            prompt: "Reverse, a lanky moonwalking dancer and Psychic-type gym leader in his twenties, drawn in negative colours: a white fedora, a black jacket worn back to front with its white buttons on the back, white trousers, a single white glove, shiny black loafers, light-skinned face, arms relaxed.",
        ),
        (
            name: "SIL_EMETTEUR",
            gfx_id: Some(0x171),
            prompt: "A Confusion Emitter, an object not a person (the same object in all three views): a thin grey metal antenna mast as tall as a person, standing on a short black tripod, a small dish near the top and a big glowing red light bulb on its tip, a small red cocktail-glass emblem (no letters) on a box at its foot.",
        ),
        // Ch9 (Nébula), ids 0x190..=0x19F.
        (
            name: "SIL_DRONE",

        "MUS_SIL_NO_MANS_LAND": "MUS_DESERT",
        "MUS_SIL_VRAI_CIEL": "MUS_ROUTE119",
        "MUS_SIL_VS_COCORICO": "MUS_VS_RIVAL",
        "MUS_SIL_VS_POUSSIN": "MUS_VS_TRAINER",

        "gBgBgBgBg",
        "BgBgBgBgB",
        "gBgBgBgBg",
        "BgBgBgBgB",
        "gBgBgBgBg",
        "BgBgXgBgB",
    ], legend: {'B': (metatile: 513, collision: 0, elevation: 3), 'g': (metatile: 554, collision: 0, elevation: 3), 'X': (metatile: 545, collision: 0, elevation: 3)}),
]

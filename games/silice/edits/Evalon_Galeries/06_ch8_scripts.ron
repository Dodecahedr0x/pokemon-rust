// SIL4 Ch8 scripts: the map changes the Chapter 8 scripts need.
[
    // The hidden-item fallback (as Ch0-Ch5): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 0, event: Bg((x: 9, y: 10, elevation: 0, kind: HiddenItem(item: "ITEM_NUGGET", flag: "FLAG_SIL_ITEM_EVALON_GALERIES_2")))).
    Replace(index: 0, event: Bg((x: 9, y: 10, elevation: 0, kind: Script(facing: 0, script: Some("Evalon_Galeries_EventScript_HiddenNugget"))))),
    // The hidden-item fallback, as above. To restore: Replace(index: 1, event: Bg((x: 18, y: 1, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_PIERRE_LIEN", flag: "FLAG_SIL_ITEM_EVALON_PIERRE_LIEN")))).
    Replace(index: 1, event: Bg((x: 18, y: 1, elevation: 0, kind: Script(facing: 0, script: Some("Evalon_Galeries_EventScript_HiddenPierreLien"))))),
]

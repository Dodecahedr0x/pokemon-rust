// Header, warps, objects, coord and bg events.
[
    Header((music: "MUS_AQUA_MAGMA_HIDEOUT", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // BricoBourg_Labo_OnTransition hides the Chimiste once VAR_SIL_BRICO_LABO_STATE is 2
    // (FLAG_SIL_HIDE_LABO_CHIMISTE).
    Scripts((on_load: None, on_transition: Some("BricoBourg_Labo_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps 0-1: the mat, to Brico-Bourg's warp 3 (the Labo door (4, 7)).
    Warp(x: 6, y: 11, dest_map: "BricoBourg", dest_warp: 3),
    Warp(x: 7, y: 11, dest_map: "BricoBourg", dest_warp: 3),
    // Trainers: the Chimiste (boss, scripted), sbire 2 (2, 3) facing left and sbire 1 (1, 8) facing
    // right. Sbire 2 was at the source's (1, 3), facing right: there she stood on the only cell
    // between the cordon's gap (1, 4) and the Chimiste, so he could not be reached (SIL2 Ch1 scripts
    // fix). At (2, 3) she watches that cell instead.
    Object(x: 2, y: 1, gfx: "OBJ_EVENT_GFX_SCIENTIST_2", id: "LOCALID_LABO_CHIMISTE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BricoBourg_Labo_EventScript_Chimiste", flag: "FLAG_SIL_HIDE_LABO_CHIMISTE"),
    Object(x: 2, y: 3, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_LABO_SBIRE_2", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "BricoBourg_Labo_EventScript_Sbire2", trainer_type: "TRAINER_TYPE_NORMAL", sight: 4),
    Object(x: 1, y: 8, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_LABO_SBIRE_1", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "BricoBourg_Labo_EventScript_Sbire1", trainer_type: "TRAINER_TYPE_NORMAL", sight: 5),
    // Items: the chest's TM (12, 3), the Silice dust on the bench (6, 7), the Revive on the floor (9, 9).
    Object(x: 12, y: 3, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_LABO_ITEM_TM", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BricoBourg_Labo_EventScript_ItemTm", flag: "FLAG_SIL_ITEM_BRICO_LABO_TM"),
    Object(x: 6, y: 7, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_LABO_ITEM_SILICE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BricoBourg_Labo_EventScript_ItemSilice", flag: "FLAG_SIL_ITEM_BRICO_LABO_SILICE"),
    Object(x: 9, y: 9, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_LABO_ITEM_REVIVE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BricoBourg_Labo_EventScript_ItemRevive", flag: "FLAG_SIL_ITEM_BRICO_LABO_REVIVE"),
    // Brico_Labo_Sc01: one step in from the mat (6-7, 10), VAR_SIL_BRICO_LABO_STATE 0.
    Coord(x: 6, y: 10, var: "VAR_SIL_BRICO_LABO_STATE", value: 0, script: "BricoBourg_Labo_Sc01"),
    Coord(x: 7, y: 10, var: "VAR_SIL_BRICO_LABO_STATE", value: 0, script: "BricoBourg_Labo_Sc01"),
    // The memo (Labo_Memo) on the desk x 11-12, y 1-2: read from (10, 2) or from below.
    Sign(x: 11, y: 2, script: "BricoBourg_Labo_EventScript_Memo"),
    Sign(x: 12, y: 2, script: "BricoBourg_Labo_EventScript_Memo"),
]

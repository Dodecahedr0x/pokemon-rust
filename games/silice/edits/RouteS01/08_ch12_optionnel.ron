// Chapter 12 (post-game): Fragment de Code 1 and Celebi at the foot of the big root (PG_Fragment, PG_Lib_Loic).
[
    // The big root, 4 cells north of the Brico-Bourg exit (y 39): no root stood there, so one is drawn on the
    // grass east of the path (11-12, 33-34), Ch0's small-root stamp (solid).
    Stamp(x: 11, y: 33, name: "SilBricoBourg_racines_petites"),
    // Fragment 1 at the root's foot (11, 35), 4 cells north of the exit row: a sign running PG_Fragment (a
    // hidden object the engine cannot hold yet; the source's Cherch'Objet fragment). The "BIP" coords two cells
    // before it on its two approaches: the path (9, 35) from the west, the grass (11, 37) from the south.
    // VAR_TEMP_1 0 fires on every step; the script checks FLAG_SIL_FRAGMENTS_ACTIFS and the fragment's flag.
    Sign(x: 11, y: 35, script: "RouteS01_PG_Fragment"),
    Coord(x: 9, y: 35, var: "VAR_TEMP_1", value: 0, script: "RouteS01_PG_FragmentBip"),
    Coord(x: 11, y: 37, var: "VAR_TEMP_1", value: 0, script: "RouteS01_PG_FragmentBip"),
    // Celebi at the root's foot beside the fragment (12, 35). Hidden until PG_Lib_Loic
    // (FLAG_SIL_LIBERATION_CELEBI) clears FLAG_SIL_HIDE_CELEBI (set at the start); a capture sets it again.
    // Placeholder sprite (no Celebi in Emerald's object set).
    Object(x: 12, y: 35, gfx: "OBJ_EVENT_GFX_TREECKO_DOLL", id: "LOCALID_ROUTE_S01_CELEBI", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "RouteS01_EventScript_Celebi", flag: "FLAG_SIL_HIDE_CELEBI"),
]

// Chapter 12 (post-game): Fragment de Code 5 (PG_Fragment).
[
    // "In the reflection of a pane of the Glass Tunnel (half-way along, east wall)": the glass gallery (x 16-40,
    // rows 5-9) runs west to east, so its long glass wall is the north one (row 4); the fragment is in the pane
    // half-way along, (28, 4) (solid), read from (28, 5). A sign running PG_Fragment. The "BIP" coords before
    // it along the gallery: (25, 5) from the west (three cells, as (26, 5) is Ch4's story coord) and (30, 5)
    // from the east (VAR_TEMP_1 0).
    Sign(x: 28, y: 4, script: "RouteS04_PG_Fragment"),
    Coord(x: 25, y: 5, var: "VAR_TEMP_1", value: 0, script: "RouteS04_PG_FragmentBip"),
    Coord(x: 30, y: 5, var: "VAR_TEMP_1", value: 0, script: "RouteS04_PG_FragmentBip"),
]

// running the `hidden_item` fallback.
[
    Replace(index: 1, event: Bg((x: 18, y: 3, elevation: 0, kind: HiddenItem(item: "ITEM_DEEP_SEA_SCALE", flag: "FLAG_SIL_ITEM_ROUTE_S05_GROTTE_ECAILLE_OCEAN")))),
]

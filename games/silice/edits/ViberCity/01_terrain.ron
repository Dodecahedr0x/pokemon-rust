    ], legend: {'.': (metatile: 512, collision: 0), 'p': (metatile: 513, collision: 0), 'q': (metatile: 514, collision: 0), 'P': (metatile: 515, collision: 0), 'Q': (metatile: 516, collision: 0), 'T': (metatile: 517, collision: 1), 't': (metatile: 518, collision: 1), 'Y': (metatile: 519, collision: 1), 'y': (metatile: 520, collision: 1), '-': (metatile: 35, collision: 0), 'g': (metatile: 1, collision: 0), 'h': (metatile: 659, collision: 0), 'f': (metatile: 658, collision: 1), 'l': (metatile: 657, collision: 1), 'L': (metatile: 664, collision: 1), 's': (metatile: 655, collision: 1), 'S': (metatile: 3, collision: 1), 'c': (metatile: 660, collision: 0), 'b': (metatile: 661, collision: 1), '!': (metatile: 468, collision: 1), '#': (metatile: 469, collision: 1), '%': (metatile: 476, collision: 1), '&': (metatile: 477, collision: 1), '3': (metatile: 392, collision: 0, elevation: 1), '4': (metatile: 393, collision: 0, elevation: 1), '5': (metatile: 400, collision: 0, elevation: 1), '6': (metatile: 368, collision: 0, elevation: 1)}),

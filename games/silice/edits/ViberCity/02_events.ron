// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_RUSTBORO", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_CITY", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnTransition: the music (silence while FLAG_SIL_VIBER_BLACKOUT is set and VAR_SIL_STORY < 35),
    // and VAR_TEMP_1 = 1 when FLAG_SIL_VIBER_BLACKOUT is set and VAR_SIL_STORY is 33 (Station_Lumiere_
    // Sc03 has just warped the player to (8, 5)). OnLoad: the barrier (32, 15-16) drawn open once
    // FLAG_SIL_VIBER_BARRIERE_EST. Viber_City_Sc05 runs from on_frame on VAR_TEMP_1 = 1 and must set
    // it back to 0 (with VAR_SIL_STORY 34), so it runs once and no script runs on other entries.
    // (Temp vars are 0 on every map load; keying on VAR_SIL_STORY 33 alone would also match before
    // the black-out and loop.)
    Scripts((on_load: Some("ViberCity_OnLoad"), on_transition: Some("ViberCity_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [(var: "VAR_TEMP_1", value: 1, script: "ViberCity_Sc05")], on_warp_into: [])),
    // Warps: 0 the Centre, 1 the Volt-Market, 2 the Station Lumiere, 3 the Nocturne, 4 the Casino,
    // 5 the dancer's house. The source's Boutique (34, 14), its barrier (37, 15-16) with its guard
    // (36, 15) and the Revive (37, 26) moved west (Volt-Market (31, 14), barrier (32, 15-16), guard
    // (31, 16), Revive (31, 25)): the east strip Route S4 sees keeps primary metatiles only.
    Warp(x: 6, y: 14, dest_map: "ViberCity_PokemonCenter", dest_warp: 0),
    Warp(x: 31, y: 14, dest_map: "ViberCity_Mart", dest_warp: 0),
    Warp(x: 8, y: 4, dest_map: "ViberCity_StationLumiere", dest_warp: 0),
    Warp(x: 28, y: 4, dest_map: "ViberCity_Gym", dest_warp: 0),
    Warp(x: 20, y: 22, dest_map: "ViberCity_Casino", dest_warp: 0),
    Warp(x: 6, y: 22, dest_map: "ViberCity_House1", dest_warp: 0),
    // Objects 1-11 in the source's numbering. Persistent hide flags, one per object:
    // - Mathieu at his stand (1): Viber_City_Sc04 sets FLAG_SIL_HIDE_VIBER_MATHIEU (he leaves as
    //   PRAUGECT), Sc05 clears it;
    // - Adrien (2): the source's FLAG_SIL_HIDE_VIBER_ADRIEN (Sc01 sets it, Sc05 shows and hides him);
    // - the dancers (3-6): dancer 1 keeps the source's FLAG_SIL_HIDE_NOCTURNE_DANSEURS, dancers 2-4
    //   have FLAG_SIL_HIDE_NOCTURNE_DANSEUR_2/_3/_4; Sc05 sets all four;
    // - Tauber (7) and Mathieu with the cart (9) start hidden (game.ron); Sc03/Sc06 and Sc04 show
    //   and hide them;
    // - the Station guard (8): the source's FLAG_SIL_HIDE_STATION_GARDE (Sc04);
    // - the east barrier's guard (17): the source's FLAG_SIL_VIBER_BARRIERE_EST (Sc06).
    // Scene paths to re-derive in Rust (the source's collide on this layout): Sc01's Walk(Up) x12
    // from (20, 29) crosses the Casino (Up x5, Left x4, Up x7, Right x4 ends on (20, 17)); Sc03's
    // Tauber stays on the door cell with Face(Down) (Walk(Down) x2 runs into dancer 1 and the
    // player); Sc04's guard, when (8, 6) fired, walks Left, Down, Left x2; Sc05 places Adrien at
    // (4, 5) and the cart Mathieu (9) at (8, 8) before showing them, so they walk up to the player
    // at (8, 5).
    Object(x: 20, y: 16, gfx: "OBJ_EVENT_GFX_SIL_MATHIEU", id: "LOCALID_VIBER_MATHIEU", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_EventScript_Mathieu", flag: "FLAG_SIL_HIDE_VIBER_MATHIEU"),
    Object(x: 21, y: 17, gfx: "OBJ_EVENT_GFX_SIL_ADRIEN", id: "LOCALID_VIBER_ADRIEN", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_EventScript_Adrien", flag: "FLAG_SIL_HIDE_VIBER_ADRIEN"),
    Object(x: 28, y: 5, gfx: "OBJ_EVENT_GFX_GIRL_3", id: "LOCALID_VIBER_DANSEUR_1", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Danseur", flag: "FLAG_SIL_HIDE_NOCTURNE_DANSEURS"),
    Object(x: 27, y: 5, gfx: "OBJ_EVENT_GFX_BOY_1", id: "LOCALID_VIBER_DANSEUR_2", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Danseur", flag: "FLAG_SIL_HIDE_NOCTURNE_DANSEUR_2"),
    Object(x: 29, y: 5, gfx: "OBJ_EVENT_GFX_WOMAN_2", id: "LOCALID_VIBER_DANSEUR_3", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Danseur", flag: "FLAG_SIL_HIDE_NOCTURNE_DANSEUR_3"),
    Object(x: 30, y: 5, gfx: "OBJ_EVENT_GFX_MAN_3", id: "LOCALID_VIBER_DANSEUR_4", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Danseur", flag: "FLAG_SIL_HIDE_NOCTURNE_DANSEUR_4"),
    Object(x: 28, y: 4, gfx: "OBJ_EVENT_GFX_SIL_TAUBER", id: "LOCALID_VIBER_TAUBER", movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_VIBER_TAUBER"),
    Object(x: 8, y: 5, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_VIBER_GARDE_STATION", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_EventScript_GardeStation", flag: "FLAG_SIL_HIDE_STATION_GARDE"),
    Object(x: 5, y: 7, gfx: "OBJ_EVENT_GFX_SIL_MATHIEU", id: "LOCALID_VIBER_MATHIEU_CHARIOT", movement: "MOVEMENT_TYPE_FACE_RIGHT", flag: "FLAG_SIL_HIDE_VIBER_MATHIEU_CHARIOT"),
    Object(x: 14, y: 11, gfx: "OBJ_EVENT_GFX_WOMAN_5", id: "LOCALID_VIBER_OUVRIERE", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Pnj04"),
    Object(x: 25, y: 14, gfx: "OBJ_EVENT_GFX_OLD_MAN", id: "LOCALID_VIBER_PAPI", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Pnj03"),
    // The other ambient NPCs (Pnj01, 02, 05, 06, 07), the east barrier's guard (PNJ 08), the items.
    Object(x: 16, y: 6, gfx: "OBJ_EVENT_GFX_MAN_4", id: "LOCALID_VIBER_BALAYEUR", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_LEFT", script: "ViberCity_EventScript_Pnj01"),
    Object(x: 13, y: 15, gfx: "OBJ_EVENT_GFX_WOMAN_3", id: "LOCALID_VIBER_VENDEUSE", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Pnj02"),
    Object(x: 18, y: 23, gfx: "OBJ_EVENT_GFX_LITTLE_BOY", id: "LOCALID_VIBER_GAMIN", movement: "MOVEMENT_TYPE_FACE_UP", script: "ViberCity_EventScript_Pnj05"),
    Object(x: 27, y: 17, gfx: "OBJ_EVENT_GFX_GENTLEMAN", id: "LOCALID_VIBER_TOURISTE", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_EventScript_Pnj06"),
    Object(x: 10, y: 16, gfx: "OBJ_EVENT_GFX_MANIAC", id: "LOCALID_VIBER_DJ", movement: "MOVEMENT_TYPE_WALK_IN_PLACE_DOWN", script: "ViberCity_EventScript_Pnj07"),
    Object(x: 31, y: 16, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_VIBER_GARDE_BARRIERE", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_EventScript_GardeBarriere", flag: "FLAG_SIL_VIBER_BARRIERE_EST"),
    Object(x: 31, y: 25, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_VIBER_ITEM_REVIVE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_EventScript_ItemRevive", flag: "FLAG_SIL_ITEM_VIBER_REVIVE"),
    // Viber_City_Sc01: the south ramp (20, 29), VAR_SIL_STORY 31.
    Coord(x: 20, y: 29, var: "VAR_SIL_STORY", value: 31, script: "ViberCity_Sc01"),
    // Viber_City_Sc03: two cells before the Nocturne door, VAR_SIL_STORY 32, on the whole row in
    // front of the dancers (27-30, 6), so the door cannot be approached without it.
    Coord(x: 27, y: 6, var: "VAR_SIL_STORY", value: 32, script: "ViberCity_Sc03"),
    Coord(x: 28, y: 6, var: "VAR_SIL_STORY", value: 32, script: "ViberCity_Sc03"),
    Coord(x: 29, y: 6, var: "VAR_SIL_STORY", value: 32, script: "ViberCity_Sc03"),
    Coord(x: 30, y: 6, var: "VAR_SIL_STORY", value: 32, script: "ViberCity_Sc03"),
    // Viber_City_Sc04: before the Station door, VAR_SIL_STORY 33 (the guard stands on (8, 5), so
    // the cells beside it).
    Coord(x: 7, y: 5, var: "VAR_SIL_STORY", value: 33, script: "ViberCity_Sc04"),
    Coord(x: 9, y: 5, var: "VAR_SIL_STORY", value: 33, script: "ViberCity_Sc04"),
    Coord(x: 8, y: 6, var: "VAR_SIL_STORY", value: 33, script: "ViberCity_Sc04"),
    // Viber_City_Sc06: leaving the Nocturne, VAR_SIL_STORY 35. The door's exit step lands on
    // (28, 5) and fires no coord event, so the three cells around it, as Brico_Bourg_Sc01 does.
    // (28, 6) also holds Sc03 (value 32): the first event whose var matches runs.
    Coord(x: 27, y: 5, var: "VAR_SIL_STORY", value: 35, script: "ViberCity_Sc06"),
    Coord(x: 29, y: 5, var: "VAR_SIL_STORY", value: 35, script: "ViberCity_Sc06"),
    Coord(x: 28, y: 6, var: "VAR_SIL_STORY", value: 35, script: "ViberCity_Sc06"),
    // Viber_City_Sc02: the giant neon sign.
    Sign(x: 20, y: 12, script: "ViberCity_Sc02"),
    Sign(x: 21, y: 28, script: "ViberCity_EventScript_Panneau1"),
    Sign(x: 31, y: 6, script: "ViberCity_EventScript_Panneau2"),
    Sign(x: 10, y: 5, script: "ViberCity_EventScript_Panneau3"),
    Sign(x: 23, y: 23, script: "ViberCity_EventScript_Panneau4"),
    HiddenItem(x: 29, y: 26, item: "ITEM_HYPER_POTION", flag: "FLAG_SIL_ITEM_VIBER_HYPER_POTION"),
    HiddenItem(x: 13, y: 3, item: "ITEM_PP_UP", flag: "FLAG_SIL_ITEM_VIBER_PP_UP"),
    // Route S3 to the south: our ramp x 20 meets its north exit x 10. The east connection to
    // MAP_ROUTE_S04 (Ch4) is added by 05_ch4_connect.ron.
    Connect((dir: South, offset: 10, map: "RouteS03")),
]

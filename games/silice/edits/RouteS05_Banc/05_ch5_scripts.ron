// SIL3 Ch5 scripts: the map changes the Chapter 5 scripts need.
[
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 0, event: Bg((x: 20, y: 20, elevation: 0, kind: HiddenItem(item: "ITEM_ULTRA_BALL", flag: "FLAG_SIL_ITEM_ROUTE_S05_BANC_ULTRA_BALL")))).
    Replace(index: 0, event: Bg((x: 20, y: 20, elevation: 0, kind: Script(facing: 0, script: Some("RouteS05_Banc_EventScript_HiddenUltraBall"))))),
]

    // set).
    Coord(x: 1, y: 6, var: "VAR_TEMP_1", value: 0, script: "Zone404_Noyau_PG_Sc26"),
    Coord(x: 2, y: 6, var: "VAR_TEMP_1", value: 0, script: "Zone404_Noyau_PG_Sc26"),

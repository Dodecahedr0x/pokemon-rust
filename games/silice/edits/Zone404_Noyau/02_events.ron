// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_NONE", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Warp 0: the mat, back to fragment 6's arrival (Zone404 warp 5).

    Object(x: 12, y: 40, gfx: "OBJ_EVENT_GFX_BREAKABLE_ROCK", id: "LOCALID_ROUTE_S07_BLOC_PUZZLE", local_id: 9, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "RouteS07_EventScript_Bloc"),

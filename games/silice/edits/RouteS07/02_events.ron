// Header, map scripts, warps, objects, coord and bg events.
[
    Header((music: "MUS_ROUTE119", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_ROUTE", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // RouteS07_Sc01 runs on entry while VAR_SIL_STORY is 68 (it sets 70).
    Scripts((on_load: None, on_transition: None, on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [(var: "VAR_SIL_STORY", value: 68, script: "RouteS07_Sc01")], on_warp_into: [])),

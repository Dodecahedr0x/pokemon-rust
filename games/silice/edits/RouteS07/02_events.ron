    Object(x: 10, y: 52, gfx: "OBJ_EVENT_GFX_BREAKABLE_ROCK", id: "LOCALID_ROUTE_S07_BLOC_C2", local_id: 5, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "RouteS07_EventScript_Bloc"),
    Object(x: 8, y: 52, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_ROUTE_S07_ITEM_TWISTED_SPOON", local_id: 6, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "RouteS07_EventScript_ItemTwistedSpoon", flag: "FLAG_SIL_ITEM_ROUTE_S07_TWISTED_SPOON"),

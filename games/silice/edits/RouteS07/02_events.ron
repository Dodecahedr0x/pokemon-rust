    Coord(x: 13, y: 34, var: "VAR_SIL_STORY", value: 70, script: "RouteS07_Sc02"),
    Coord(x: 14, y: 34, var: "VAR_SIL_STORY", value: 70, script: "RouteS07_Sc02"),
    Coord(x: 15, y: 34, var: "VAR_SIL_STORY", value: 70, script: "RouteS07_Sc02"),

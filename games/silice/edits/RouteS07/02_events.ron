    Object(x: 22, y: 27, gfx: "OBJ_EVENT_GFX_HEX_MANIAC", id: "LOCALID_ROUTE_S07_MIRA", local_id: 13, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "RouteS07_EventScript_Mira", trainer_type: "TRAINER_TYPE_NORMAL", sight: 5),

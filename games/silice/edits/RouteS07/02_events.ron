    Sign(x: 17, y: 69, script: "RouteS07_EventScript_SignEntree"),
    Sign(x: 13, y: 62, script: "RouteS07_EventScript_SignBloc"),
    Sign(x: 12, y: 1, script: "RouteS07_EventScript_SignPorte"),
    // The hidden Ether at the foot of S7-C's railing post.
    HiddenItem(x: 21, y: 32, item: "ITEM_ETHER", flag: "FLAG_SIL_ITEM_ROUTE_S07_HIDDEN_ETHER"),

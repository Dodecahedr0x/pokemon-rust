// Header, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_ROUTE110", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_ROUTE", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Warp 0: the south portal, to the depot's south entry. Warp 1: the north portal, to the

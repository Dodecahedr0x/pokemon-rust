    Warp(x: 10, y: 20, dest_map: "RouteS03_Depot", dest_warp: 0),
    Warp(x: 10, y: 17, dest_map: "RouteS03_Depot", dest_warp: 1),
    // The source's ambient NPCs (Pnj01-03), the portal guard, then the trainers and items.

// SIL6 Ch12 scripts: the map changes the Chapter 12 scripts need.
[
    // The hidden-item fallback (as Ch0-Ch11): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 2, event: Bg((x: 34, y: 46, elevation: 0, kind: HiddenItem(item: "ITEM_PP_MAX", flag: "FLAG_SIL_ITEM_PG_NML_PPMAX")))).
    Replace(index: 2, event: Bg((x: 34, y: 46, elevation: 0, kind: Script(facing: 0, script: Some("NoMansLand_EventScript_HiddenPpMax"))))),
]

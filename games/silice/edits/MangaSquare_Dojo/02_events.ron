// Header, map scripts, warps, objects, bg event. Local ids 5-13 are the source's obj numbers.
[
    Header((music: "MUS_CONTEST_LOBBY", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // on_transition: from VAR_SIL_STORY 64 the monk stands aside (setobjectxyperm to (28, 5), facing left:
    // (27, 5) would still block (27, 4), the only cell in front of the door's alcove); the hide
    // flags of Adrien, Kimiko and the drones are set by the scenes.
    Scripts((on_load: None, on_transition: Some("MangaSquare_Dojo_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the exit mat, to Manga-Square's warp 1. Warp 1: the back door (a shoji, solid: pushing up
    // into it warps) to the zen garden, MangaSquare_Gym's warp 0.
    Warp(x: 4, y: 21, dest_map: "MangaSquare", dest_warp: 1),
    Warp(x: 27, y: 2, dest_map: "MangaSquare_Gym", dest_warp: 0),
    // The stands, from the entrance to the back.
    Object(x: 3, y: 5, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_DOJO_SHINOBI_GEAR", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_ShinobiGear"),
    Object(x: 3, y: 11, gfx: "OBJ_EVENT_GFX_WOMAN_2", id: "LOCALID_DOJO_RESTAURATRICE", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_Restauratrice"),
    Object(x: 8, y: 13, gfx: "OBJ_EVENT_GFX_GIRL_3", id: "LOCALID_DOJO_COSPLAY_1", local_id: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_Cosplay1"),
    Object(x: 10, y: 13, gfx: "OBJ_EVENT_GFX_SAILOR", id: "LOCALID_DOJO_COSPLAY_2", local_id: 4, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_Cosplay2"),
    // The signing queue (y 10), its ribbons at y 11: Adrien last, then the three Fans Ultras; Kimiko and
    // her two drones on the stage.
    Object(x: 13, y: 10, gfx: "OBJ_EVENT_GFX_SIL_ADRIEN", id: "LOCALID_DOJO_ADRIEN", local_id: 5, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "MangaSquare_Dojo_Sc01", flag: "FLAG_SIL_HIDE_DOJO_ADRIEN"),
    Object(x: 15, y: 10, gfx: "OBJ_EVENT_GFX_POKEFAN_M", id: "LOCALID_DOJO_FAN_KEVIN", local_id: 6, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "MangaSquare_Dojo_EventScript_Kevin"),
    Object(x: 16, y: 10, gfx: "OBJ_EVENT_GFX_FAT_MAN", id: "LOCALID_DOJO_FAN_BRUNO", local_id: 7, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "MangaSquare_Dojo_EventScript_Bruno"),
    Object(x: 17, y: 10, gfx: "OBJ_EVENT_GFX_POKEFAN_F", id: "LOCALID_DOJO_FAN_DIANE", local_id: 8, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "MangaSquare_Dojo_EventScript_Diane"),
    Object(x: 21, y: 5, gfx: "OBJ_EVENT_GFX_LIZA", id: "LOCALID_DOJO_KIMIKO", local_id: 9, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_Kimiko", flag: "FLAG_SIL_HIDE_DOJO_KIMIKO"),
    Object(x: 19, y: 4, gfx: "OBJ_EVENT_GFX_WINGULL", id: "LOCALID_DOJO_DRONE_1", local_id: 10, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_DOJO_DRONE_1"),
    Object(x: 24, y: 4, gfx: "OBJ_EVENT_GFX_WINGULL", id: "LOCALID_DOJO_DRONE_2", local_id: 11, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_DOJO_DRONE_2"),
    // Manga_Square_Dojo_Sc02: the disappointed fan (215th), sitting near the exit.
    Object(x: 6, y: 19, gfx: "OBJ_EVENT_GFX_MANIAC", id: "LOCALID_DOJO_FAN_DECU", local_id: 12, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_Sc02"),
    // Manga_Square_Dojo_Sc04: the cook at the food stand.
    Object(x: 8, y: 5, gfx: "OBJ_EVENT_GFX_COOK", id: "LOCALID_DOJO_CUISINIER", local_id: 13, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_Sc04"),
    // Manga_Square_Dojo_Sc03: KENTA on the training mat.
    Object(x: 13, y: 15, gfx: "OBJ_EVENT_GFX_BLACK_BELT", id: "LOCALID_DOJO_KENTA", local_id: 14, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_Sc03", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    // The gate monk: (27, 4) is the only way to the back door (reached from (27, 5)) until VAR_SIL_STORY 64.
    Object(x: 27, y: 4, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_DOJO_MOINE", local_id: 15, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Dojo_EventScript_Moine"),
    Sign(x: 7, y: 2, script: "MangaSquare_Dojo_EventScript_SignCode"),
]

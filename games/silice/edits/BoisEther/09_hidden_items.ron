// The hidden items wave: the hidden items are Gen3's own again (BgKind::HiddenItem: A in front
// of one runs the game's EventScript_HiddenItemScript, silice::scripts::field), no longer signs
// running the `hidden_item` fallback.
[
    Replace(index: 6, event: Bg((x: 4, y: 14, elevation: 0, kind: HiddenItem(item: "ITEM_SUPER_POTION", flag: "FLAG_SIL_ITEM_BOIS_ETHER_SUPER_POTION")))),
    Replace(index: 7, event: Bg((x: 4, y: 7, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_EVOLUROC", flag: "FLAG_SIL_ITEM_BOIS_ETHER_EVOLUROC")))),
]

    Object(x: 19, y: 10, gfx: "OBJ_EVENT_GFX_ARCHIE", id: "LOCALID_BOIS_ETHER_ROMAIN", movement: "MOVEMENT_TYPE_FACE_UP", flag: "FLAG_SIL_HIDE_BOIS_ETHER_ROMAIN"),

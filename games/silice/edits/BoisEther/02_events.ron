// Header, map scripts, warps, objects, coord and bg events, connection.
[
    Header((music: "MUS_FORTREE", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_TOWN", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // BoisEther_OnTransition sets the actors' hide flags (FLAG_SIL_HIDE_BOIS_ETHER_*, one per object)
    // from VAR_SIL_STORY, the red sky (FLAG_SIL_BOIS_ETHER_RED_SKY) and the music. BoisEther_OnLoad
    // repaints the cut brambles (FLAG_SIL_BOIS_ETHER_RONCES_CUT) and the open barrier (VAR_SIL_STORY >= 17).
    Scripts((on_load: Some("BoisEther_OnLoad"), on_transition: Some("BoisEther_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the gym. 1: the Pokemon Center. 2: the Mart. 3: the Herboriste.
    Warp(x: 17, y: 4, dest_map: "BoisEther_Gym", dest_warp: 0),
    Warp(x: 27, y: 12, dest_map: "BoisEther_PokemonCenter", dest_warp: 0),
    Warp(x: 27, y: 17, dest_map: "BoisEther_Mart", dest_warp: 0),
    Warp(x: 5, y: 12, dest_map: "BoisEther_Herboriste", dest_warp: 0),
    // Objects 1-15 in the source's obj order; 16 (reserved) is not drawn, so the X Defend ball takes 16.
    Object(x: 10, y: 7, gfx: "OBJ_EVENT_GFX_WOMAN_2", id: "LOCALID_BOIS_ETHER_JARDINIERE", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "BoisEther_EventScript_Jardiniere"),
    Object(x: 14, y: 12, gfx: "OBJ_EVENT_GFX_OLD_MAN", id: "LOCALID_BOIS_ETHER_VIEUX", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "BoisEther_EventScript_Vieux"),
    Object(x: 20, y: 7, gfx: "OBJ_EVENT_GFX_LITTLE_GIRL", id: "LOCALID_BOIS_ETHER_FILLETTE", movement: "MOVEMENT_TYPE_WANDER_AROUND", range_x: 1, range_y: 1, script: "BoisEther_EventScript_Fillette"),
    Object(x: 6, y: 14, gfx: "OBJ_EVENT_GFX_POKEFAN_M", id: "LOCALID_BOIS_ETHER_MARCHAND", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BoisEther_EventScript_Marchand"),
    Object(x: 16, y: 6, gfx: "OBJ_EVENT_GFX_BOY_3", id: "LOCALID_BOIS_ETHER_FAN", movement: "MOVEMENT_TYPE_FACE_UP", script: "BoisEther_EventScript_Fan"),
    Object(x: 24, y: 3, gfx: "OBJ_EVENT_GFX_SCIENTIST_1", id: "LOCALID_BOIS_ETHER_TECHNICIEN", movement: "MOVEMENT_TYPE_FACE_UP", script: "BoisEther_EventScript_Technicien", flag: "FLAG_SIL_HIDE_BOIS_ETHER_TECHNICIEN"),
    Object(x: 22, y: 14, gfx: "OBJ_EVENT_GFX_WOMAN_4", id: "LOCALID_BOIS_ETHER_TOUX", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "BoisEther_EventScript_Toux"),

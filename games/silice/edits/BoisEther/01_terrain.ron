        "TtTtTtTtTtTt....TtTtTtTtTtTtTtTtTtTt",
        "YyYyYyYyYyYy....YyYyYyYyYyYyYyYyYyYy",
    ], legend: {'T': (metatile: 468, collision: 1), 't': (metatile: 469, collision: 1), 'Y': (metatile: 476, collision: 1), 'y': (metatile: 477, collision: 1), '.': (metatile: 1, collision: 0), ',': (metatile: 13, collision: 0), '*': (metatile: 4, collision: 0), 's': (metatile: 27, collision: 1), 'b': (metatile: 6, collision: 1), '=': (metatile: 619, collision: 1), ':': (metatile: 624, collision: 0), 'p': (metatile: 625, collision: 1), 'x': (metatile: 626, collision: 1), 'h': (metatile: 627, collision: 1), 'f': (metatile: 630, collision: 1), 'n': (metatile: 637, collision: 1)}),
    // LA GRASS-HOPPER, the giant hollow tree ringed with metal hoops and pipes (the gym), x 13-21,
    // y 0-4, door (17, 4); its deck is the path row y 5.
    Stamp(x: 13, y: 0, name: "SilBoisEther_grass_hopper"),
    // L'HERBORISTE, the tiny greenhouse shop of the medicinal-plant market, x 3-7, y 10-12, door (5, 12).
    Stamp(x: 3, y: 10, name: "SilBoisEther_herboriste"),
    // The market's stalls, in front of the merchant (6, 14).
    Stamp(x: 7, y: 14, name: "SilBoisEther_etal"),
    Stamp(x: 2, y: 14, name: "SilBoisEther_etal"),
    // LE GRAND CHENE, x 15-19, y 7-10 (crown y 7-8, trunk x 16-18, y 9-10; its sign is the trunk (17, 10)).
    // (15, 9-10) and (19, 9-10) stay walkable: Gogo and Romain stand at (15, 10) and (19, 10) in Sc06.
    Stamp(x: 15, y: 7, name: "SilBoisEther_grand_chene"),
    // Houses on stilts between the roots (no interior, no door cell).
    // The north-east one stands in the forest's edge (x 28-30, y 0-4), out of Route S2's view.
    Stamp(x: 22, y: 5, name: "SilBoisEther_maison_pilotis"),
    Stamp(x: 28, y: 0, name: "SilBoisEther_maison_pilotis"),
    // Houses nested in tree trunks (no interior, no door cell).

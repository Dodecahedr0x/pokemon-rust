// Cells (one Ascii op), then SilReverseCity's stamps (games/silice/gfx/SilReverseCity.ron, original art):
// the negative city at the bottom of the covered crater. The crater wall (paroi) rings the map; on its
// ceiling (rows 0-2) houses hang upside down. North: the Porte Eta-Nord (x 25-29, y 0-1, door (27, 0)),
// the vault bunker (x 12-14, y 1-3, door (13, 3)) at the end of the alley (x 10, y 4-9) behind the Palais
// (x 2-8, y 5-8, door (5, 8)), the Supermarche Cocket (x 29-33, y 6-8, door (31, 8)), houses standing
// on their roofs. The square with the upside-down fountain (19-20, 10-11) and blue lawns; the Cocket
// barrier (y 16, open on x 17-21). South: the Centre (x 2-6, y 18-20, door (4, 20)), the "villain's"
// house (x 9-11, y 17-20, door (10, 20)), the blue tall grass (16-21, 19-23), the upturned bins, the red
// quay water (x 1-25, y 27-32; surfable, fishable pond water), the black-light lighthouse (x 28-30,
// y 25-28, door (29, 28)), the south gate mats (General 36). The mirror signs are this tileset's.
[
    Ascii(x: 0, y: 0, rows: [
        "RRRRRRRRRRRRRRRRRRRRRRRRRR...RRRRRRRRRRR",
        "RRRRRRRRRRRR...RRRRRRRRRRR...RRRRRRRRRRR",
        "RRRRRRRRRRRR...RRRRRRRRRRR...RRRRRRRRRRR",
        "R........RRR...R.......................R",
        "R........R.....R.......................R",
        "R........R.RRRRR.......................R",
        "R........R.RRRRR.......................R",
        "R........R.RRRRR.......................R",
        "R........R.RRRRR..................s....R",
        "R.s....................................R",
        "R......................................R",
        "R......................................R",
        "R.bbbbbbb......................bbbbbbb.R",
        "R.bbbbbbb......................bbbbbbb.R",
        "R.bbbbbbb......................bbbbbbb.R",
        "R......................................R",
        "Rffffffffffffffff.....fffffffffffffffffR",
        "R......................................R",
        "R.............u........................R",
        "R...............gggggg...........u.....R",
        "R......s........gggggg.................R",
        "R...............gggggg.bbbbb...........R",
        "R.u.............gggggg.bbbbb...........R",
        "R...............gggggg.bbbbb...........R",
        "R.bbbbbbb..............................R",
        "R.bbbbbbb...............u..............R",
        "R......................................R",
        "Rqqqqqqqqqqqqqqqqqqqqqqqqd.............R",
        "R~~~~~~~~~~~~~~~~~~~~~~~~d.....s.......R",
        "R~~~~~~~~~~~~~~~~~~~~~~~~d.............R",
        "R~~~~~~~~~~~~~~~~~~~~~~~~d.............R",
        "R~~~~~~~~~~~~~~~~~~~~~~~~d.......bbbbb.R",
        "Rmmmmmmmmmmmmmmmmmmmmmmmmm.......bbbbb.R",
        "R......................................R",
        "RRRRRRRRRRRR.RRRRRRRRRRRRRRRRs...RRRRRRR",
        "RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRzzzRRRRRRR",
    ], legend: {
        'R': (metatile: 640, collision: 1),
        '.': (metatile: 639, collision: 0),
        'b': (metatile: 642, collision: 0),
        'g': (metatile: 641, collision: 0),
        'q': (metatile: 644, collision: 0, elevation: 1),
        'd': (metatile: 645, collision: 0, elevation: 1),
        '~': (metatile: 643, collision: 0, elevation: 1),
        'm': (metatile: 646, collision: 1),
        'f': (metatile: 647, collision: 1),
        'u': (metatile: 648, collision: 1),
        's': (metatile: 649, collision: 1),
        'z': (metatile: 36, collision: 0),
    }),
    // The crater's ceiling: houses hanging upside down, their doors lost in the rock.
    Stamp(x: 2, y: 0, name: "SilReverseCity_maison_suspendue"),
    Stamp(x: 6, y: 0, name: "SilReverseCity_maison_suspendue"),
    Stamp(x: 17, y: 0, name: "SilReverseCity_maison_suspendue"),
    Stamp(x: 21, y: 0, name: "SilReverseCity_maison_suspendue"),
    Stamp(x: 31, y: 0, name: "SilReverseCity_maison_suspendue"),
    Stamp(x: 35, y: 0, name: "SilReverseCity_maison_suspendue"),
    // The Porte Eta-Nord, door (27, 0) shut (solid) until ReverseCity_Sc07 paints METATILE_PORTE_NORD.
    Stamp(x: 25, y: 0, name: "SilReverseCity_porte_nord"),
    // The vault bunker, door (13, 3); the Palais des Paradoxes, door (5, 8).
    Stamp(x: 12, y: 1, name: "SilReverseCity_coffre"),
    Stamp(x: 2, y: 5, name: "SilReverseCity_palais"),
    // Houses standing on their roofs: behind the Palais (12-14, 5-8), on the square (18-20, 3-6), north
    // east (35-37, 3-6), south of the barrier (26-28, 17-20).
    Stamp(x: 12, y: 5, name: "SilReverseCity_maison_renversee"),
    Stamp(x: 18, y: 3, name: "SilReverseCity_maison_renversee"),
    Stamp(x: 35, y: 3, name: "SilReverseCity_maison_renversee"),
    Stamp(x: 26, y: 17, name: "SilReverseCity_maison_renversee"),
    // The Supermarche Cocket, door (31, 8); the upside-down fountain (19-20, 10-11).
    Stamp(x: 29, y: 6, name: "SilReverseCity_mart"),
    Stamp(x: 19, y: 10, name: "SilReverseCity_fontaine"),
    // Cocket banners: the official outpost's logos round the square, by the grass and the lighthouse.
    Stamp(x: 15, y: 10, name: "SilReverseCity_banniere"),
    Stamp(x: 24, y: 10, name: "SilReverseCity_banniere"),
    Stamp(x: 37, y: 24, name: "SilReverseCity_banniere"),
    Stamp(x: 27, y: 31, name: "SilReverseCity_banniere"),
    // The Centre, door (4, 20); the "villain's" house, door (10, 20); the lighthouse, door (29, 28).
    Stamp(x: 2, y: 18, name: "SilReverseCity_centre"),
    Stamp(x: 9, y: 17, name: "SilReverseCity_maison"),
    Stamp(x: 28, y: 25, name: "SilReverseCity_phare"),
]

// Header, map scripts, warps, objects, coord and bg events.
[
    Header((music: "MUS_VERDANTURF", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_CITY", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // ReverseCity_OnLoad repaints the open Porte Eta-Nord once FLAG_SIL_REVERSE_PORTE_NORD_OUVERTE is set.
    // ReverseCity_OnTransition: set_input_inverted(!FLAG_SIL_REVERSE_BATTU), the hide flags.
    Scripts((on_load: Some("ReverseCity_OnLoad"), on_transition: Some("ReverseCity_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps 0-2: the south gate mats, to Route S7's warp 0 (the Secteur Eta gate).
    Warp(x: 30, y: 35, dest_map: "RouteS07", dest_warp: 0),
    Warp(x: 31, y: 35, dest_map: "RouteS07", dest_warp: 0),
    Warp(x: 32, y: 35, dest_map: "RouteS07", dest_warp: 0),
    // Warps 3-8: the Centre, the Mart, the house, the lighthouse, the Palais, the vault.
    Warp(x: 4, y: 20, dest_map: "ReverseCity_PokemonCenter", dest_warp: 0),
    Warp(x: 31, y: 8, dest_map: "ReverseCity_Mart", dest_warp: 0),
    Warp(x: 10, y: 20, dest_map: "ReverseCity_House1", dest_warp: 0),
    Warp(x: 29, y: 28, dest_map: "ReverseCity_Phare", dest_warp: 0),
    Warp(x: 5, y: 8, dest_map: "ReverseCity_Gym", dest_warp: 0),
    Warp(x: 13, y: 3, dest_map: "ReverseCity_Coffre", dest_warp: 0),
    // Objects: local ids 5, 6, 10-12 and 15 are the source's.
    Object(x: 25, y: 20, gfx: "OBJ_EVENT_GFX_MAN_3", id: "LOCALID_REVERSE_HABITANT1", local_id: 1, movement: "MOVEMENT_TYPE_WANDER_UP_AND_DOWN", range_x: 0, range_y: 2, script: "ReverseCity_EventScript_Habitant1"),
    Object(x: 12, y: 24, gfx: "OBJ_EVENT_GFX_WOMAN_3", id: "LOCALID_REVERSE_HABITANT2", local_id: 2, movement: "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT", range_x: 2, range_y: 0, script: "ReverseCity_EventScript_Habitant2"),
    Object(x: 6, y: 26, gfx: "OBJ_EVENT_GFX_LITTLE_BOY", id: "LOCALID_REVERSE_ENFANT", local_id: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_Enfant"),
    Object(x: 22, y: 12, gfx: "OBJ_EVENT_GFX_OLD_WOMAN", id: "LOCALID_REVERSE_VIEILLE", local_id: 4, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ReverseCity_EventScript_Vieille"),
    Object(x: 18, y: 12, gfx: "OBJ_EVENT_GFX_MAXIE", id: "LOCALID_REVERSE_GOGO", local_id: 5, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_REVERSE_GOGO_ROMAIN"),
    Object(x: 21, y: 12, gfx: "OBJ_EVENT_GFX_ARCHIE", id: "LOCALID_REVERSE_ROMAIN", local_id: 6, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_REVERSE_ROMAIN"),
    Object(x: 32, y: 9, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_REVERSE_SBIRE_PROMO", local_id: 7, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_SbirePromo"),
    Object(x: 20, y: 26, gfx: "OBJ_EVENT_GFX_HIKER", id: "LOCALID_REVERSE_DOCKER", local_id: 8, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_Docker"),
    Object(x: 5, y: 9, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_REVERSE_GARDE_PALAIS", local_id: 9, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_GardePalais", flag: "FLAG_SIL_HIDE_REVERSE_GARDE_PALAIS"),
    // The Emetteurs de Confusion, as the source's fallback trainer objects (sight 2).
    Object(x: 3, y: 12, gfx: "OBJ_EVENT_GFX_TRICK_HOUSE_STATUE", id: "LOCALID_REVERSE_EMETTEUR1", local_id: 10, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ReverseCity_EventScript_Emetteur1", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 36, y: 12, gfx: "OBJ_EVENT_GFX_TRICK_HOUSE_STATUE", id: "LOCALID_REVERSE_EMETTEUR2", local_id: 11, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ReverseCity_EventScript_Emetteur2", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 12, y: 34, gfx: "OBJ_EVENT_GFX_TRICK_HOUSE_STATUE", id: "LOCALID_REVERSE_EMETTEUR3", local_id: 12, movement: "MOVEMENT_TYPE_FACE_UP", script: "ReverseCity_EventScript_Emetteur3", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    // The alley sbire stands at the alley's mouth (10, 9), on the near side of the block he talks about.
    Object(x: 11, y: 9, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_REVERSE_SBIRE_RUELLE", local_id: 13, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ReverseCity_EventScript_SbireRuelle"),
    Object(x: 10, y: 6, gfx: "OBJ_EVENT_GFX_BREAKABLE_ROCK", id: "LOCALID_REVERSE_BLOC_RUELLE", local_id: 14, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_BlocRuelle"),
    Object(x: 29, y: 3, gfx: "OBJ_EVENT_GFX_SIL_BENOU", id: "LOCALID_REVERSE_BENOU_PORTE", local_id: 15, movement: "MOVEMENT_TYPE_FACE_LEFT", flag: "FLAG_SIL_HIDE_REVERSE_BENOU_PORTE"),
    Object(x: 21, y: 26, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_REVERSE_ITEM_POUDRE_SILICE", local_id: 16, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_EventScript_ItemPoudreSilice", flag: "FLAG_SIL_ITEM_REVERSE_POUDRE_SILICE"),
    Object(x: 31, y: 30, gfx: "OBJ_EVENT_GFX_MAN_1", id: "LOCALID_REVERSE_HABITANT_ACCUEIL", local_id: 17, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_REVERSE_HABITANT_ACCUEIL"),
    Object(x: 35, y: 22, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_REVERSE_SBIRE1", local_id: 18, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ReverseCity_EventScript_Sbire1", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 36, y: 30, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_REVERSE_SBIRE2", local_id: 19, movement: "MOVEMENT_TYPE_FACE_UP", script: "ReverseCity_EventScript_Sbire2", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    // Reverse_City_Sc01: the row in front of the south mats, the only way in (VAR_SIL_STORY 71).
    Coord(x: 30, y: 34, var: "VAR_SIL_STORY", value: 71, script: "ReverseCity_Sc01"),
    Coord(x: 31, y: 34, var: "VAR_SIL_STORY", value: 71, script: "ReverseCity_Sc01"),
    Coord(x: 32, y: 34, var: "VAR_SIL_STORY", value: 71, script: "ReverseCity_Sc01"),
    // Reverse_City_Sc02: the gap in the square's fence, the only way to the north half (72).
    Coord(x: 17, y: 16, var: "VAR_SIL_STORY", value: 72, script: "ReverseCity_Sc02"),
    Coord(x: 18, y: 16, var: "VAR_SIL_STORY", value: 72, script: "ReverseCity_Sc02"),
    Coord(x: 19, y: 16, var: "VAR_SIL_STORY", value: 72, script: "ReverseCity_Sc02"),
    Coord(x: 20, y: 16, var: "VAR_SIL_STORY", value: 72, script: "ReverseCity_Sc02"),
    Coord(x: 21, y: 16, var: "VAR_SIL_STORY", value: 72, script: "ReverseCity_Sc02"),
    // Reverse_City_Sc07: two cells before the Porte Eta-Nord (75).
    Coord(x: 26, y: 3, var: "VAR_SIL_STORY", value: 75, script: "ReverseCity_Sc07"),
    Coord(x: 27, y: 3, var: "VAR_SIL_STORY", value: 75, script: "ReverseCity_Sc07"),
    Coord(x: 28, y: 3, var: "VAR_SIL_STORY", value: 75, script: "ReverseCity_Sc07"),
    // The mirror signs: plaque 1 (south gate), 2 (Mart), 3 (lighthouse), 4 (Palais), the Centre.
    Sign(x: 29, y: 34, script: "ReverseCity_EventScript_SignVille"),
    Sign(x: 34, y: 8, script: "ReverseCity_EventScript_SignMart"),
    Sign(x: 31, y: 28, script: "ReverseCity_EventScript_SignPhare"),
    Sign(x: 2, y: 9, script: "ReverseCity_EventScript_SignGym"),
    Sign(x: 7, y: 20, script: "ReverseCity_EventScript_SignPC"),
    // The upside-down bins: 1 (14, 18) and 3 (33, 19) are empty, 2 (west alley) and 4 (quays) hide items.
    Sign(x: 14, y: 18, script: "ReverseCity_EventScript_Poubelle"),
    Sign(x: 33, y: 19, script: "ReverseCity_EventScript_Poubelle"),
    HiddenItem(x: 2, y: 22, item: "ITEM_PP_UP", flag: "FLAG_SIL_ITEM_REVERSE_PP_UP"),
    HiddenItem(x: 24, y: 25, item: "ITEM_HP_UP", flag: "FLAG_SIL_ITEM_REVERSE_HP_UP"),
    HiddenItem(x: 26, y: 30, item: "ITEM_SIL_POUDRE_SILICE", flag: "FLAG_SIL_ITEM_REVERSE_POUDRE_SILICE_2"),
]

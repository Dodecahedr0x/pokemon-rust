// The hidden items wave: the hidden items are Gen3's own again (BgKind::HiddenItem: A in front
// of one runs the game's EventScript_HiddenItemScript, silice::scripts::field), no longer signs
// running the `hidden_item` fallback.
[
    Replace(index: 7, event: Bg((x: 2, y: 22, elevation: 0, kind: HiddenItem(item: "ITEM_PP_UP", flag: "FLAG_SIL_ITEM_REVERSE_PP_UP")))),
    Replace(index: 8, event: Bg((x: 24, y: 25, elevation: 0, kind: HiddenItem(item: "ITEM_HP_UP", flag: "FLAG_SIL_ITEM_REVERSE_HP_UP")))),
    Replace(index: 9, event: Bg((x: 26, y: 30, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_POUDRE_SILICE", flag: "FLAG_SIL_ITEM_REVERSE_POUDRE_SILICE_2")))),
]

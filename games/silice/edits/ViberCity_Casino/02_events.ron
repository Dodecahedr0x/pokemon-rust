// Header, map scripts, warps, objects, coord and bg events.
[
    Header((music: "MUS_GAME_CORNER", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnLoad: the stairs (18, 1) drawn as the exit mat once VAR_SIL_CASINO_STATE >= 2 (Casino_Sc08).
    // OnTransition owns the hide flags of Gogo and Romain: shown from VAR_SIL_STORY 32 while
    // VAR_SIL_CASINO_STATE < 3 (they stay after Casino_Sc03 with their repeatable lines; at 3
    // Romain is downstairs, B1F_Sc02). Both start hidden (game.ron).
    Scripts((on_load: Some("ViberCity_Casino_OnLoad"), on_transition: Some("ViberCity_Casino_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps 0-1: the entrance mat, to Viber-City's warp 4. Warp 2: the hidden stairs (18, 1), to
    // the basement. The stairs cell becomes a south arrow mat (the game corner set has no
    // stairs): the player steps on it, then presses down.
    Warp(x: 9, y: 10, dest_map: "ViberCity", dest_warp: 4),
    Warp(x: 10, y: 10, dest_map: "ViberCity", dest_warp: 4),
    Warp(x: 18, y: 1, dest_map: "ViberCity_Casino_B1F", dest_warp: 0),
    // Gogo plays the violet machine (2, 1) on his left.
    Object(x: 3, y: 1, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_CASINO_GOGO", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_Casino_EventScript_Gogo", flag: "FLAG_SIL_HIDE_CASINO_GOGO"),
    Object(x: 5, y: 1, gfx: "OBJ_EVENT_GFX_AQUA_MEMBER_M", id: "LOCALID_CASINO_ROMAIN", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_Casino_EventScript_Romain", flag: "FLAG_SIL_HIDE_CASINO_ROMAIN"),
    Object(x: 10, y: 1, gfx: "OBJ_EVENT_GFX_WOMAN_5", id: "LOCALID_CASINO_CROUPIERE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_Casino_Sc05"),
    Object(x: 9, y: 4, gfx: "OBJ_EVENT_GFX_GENTLEMAN", id: "LOCALID_CASINO_FERNAND", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_Casino_EventScript_Fernand", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 9, y: 6, gfx: "OBJ_EVENT_GFX_MANIAC", id: "LOCALID_CASINO_DEX", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_Casino_Sc04"),
    Object(x: 11, y: 7, gfx: "OBJ_EVENT_GFX_FAT_MAN", id: "LOCALID_CASINO_GASTON", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_Casino_EventScript_Gaston", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    // The two counter clerks stand behind the counters (3, 7) and (16, 7): the player talks
    // across the counter from row 9 (the source puts J and L on the counter cells).
    Object(x: 3, y: 7, gfx: "OBJ_EVENT_GFX_WOMAN_2", id: "LOCALID_CASINO_JETONS", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_Casino_Sc02"),
    Object(x: 16, y: 7, gfx: "OBJ_EVENT_GFX_MAN_2", id: "LOCALID_CASINO_LOTS", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_Casino_Sc07"),
    Object(x: 2, y: 9, gfx: "OBJ_EVENT_GFX_MAN_1", id: "LOCALID_CASINO_VENDEUR", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ViberCity_Casino_Sc01"),
    Object(x: 13, y: 9, gfx: "OBJ_EVENT_GFX_LASS", id: "LOCALID_CASINO_SOLENE", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_Casino_EventScript_Solene", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    // Ambient: Pnj01 at his machine, Pnj02 the old lady, Pnj03 the waiter, Pnj04 the guard by
    // the poster, on (18, 2) below the stairs: (17, 1), the only cell to read the poster from, is
    // reached through (16, 1), which he must not block.
    Object(x: 15, y: 3, gfx: "OBJ_EVENT_GFX_MAN_4", id: "LOCALID_CASINO_PNJ01", movement: "MOVEMENT_TYPE_FACE_UP", script: "ViberCity_Casino_EventScript_Pnj01"),
    Object(x: 4, y: 5, gfx: "OBJ_EVENT_GFX_WOMAN_3", id: "LOCALID_CASINO_PNJ02", movement: "MOVEMENT_TYPE_FACE_UP", script: "ViberCity_Casino_EventScript_Pnj02"),
    Object(x: 7, y: 9, gfx: "OBJ_EVENT_GFX_BOY_1", id: "LOCALID_CASINO_PNJ03", movement: "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT", range_x: 1, range_y: 0, script: "ViberCity_Casino_EventScript_Pnj03"),
    Object(x: 18, y: 2, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_CASINO_PNJ04", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_Casino_EventScript_Pnj04"),
    // Casino_Sc03: two cells before Gogo, VAR_SIL_CASINO_STATE 0 (the script checks the story).
    Coord(x: 3, y: 3, var: "VAR_SIL_CASINO_STATE", value: 0, script: "ViberCity_Casino_Sc03"),
    // Casino_Sc06: the slot machines, read from the row below; Casino_Sc05: the roulette table;
    // Casino_Sc08: the poster (17, 0) read from (17, 1). The hidden coins (14, 3): a bg event.
    Sign(x: 2, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 3, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 4, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 5, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 6, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 14, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 15, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 16, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 17, y: 2, script: "ViberCity_Casino_Sc06"),
    Sign(x: 2, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 3, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 4, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 5, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 6, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 14, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 15, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 16, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 17, y: 4, script: "ViberCity_Casino_Sc06"),
    Sign(x: 2, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 3, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 4, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 5, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 6, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 14, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 15, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 16, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 17, y: 6, script: "ViberCity_Casino_Sc06"),
    Sign(x: 9, y: 2, script: "ViberCity_Casino_Sc05"),
    Sign(x: 10, y: 2, script: "ViberCity_Casino_Sc05"),
    Sign(x: 11, y: 2, script: "ViberCity_Casino_Sc05"),
    Sign(x: 17, y: 0, script: "ViberCity_Casino_Sc08"),
    Sign(x: 2, y: 1, script: "ViberCity_Casino_EventScript_MachineViolette"),
    Sign(x: 14, y: 3, script: "ViberCity_Casino_EventScript_JetonsCaches"),
]

// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_AQUA_MAGMA_HIDEOUT", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnLoad: each sas drawn open once its guards are beaten (trainer flags): sas 1 (19-21, 11) for Sbire 3,
    // sas 2 (14, 9-10) for Viktor and Nadia, sas 3 (11-13, 5) for Kroll.
    Scripts((on_load: Some("Nebula_TourHall_OnLoad"), on_transition: None, on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps 0-1: the service stairs' mat, down to B1F's warp 0.
    Warp(x: 20, y: 15, dest_map: "Nebula_TourHall_B1F", dest_warp: 0),
    Warp(x: 21, y: 15, dest_map: "Nebula_TourHall_B1F", dest_warp: 0),
    // Nebula_TourHall_Sc02 (Tour_Hall_Sc02, l'ascenseur de cristal) at VAR_SIL_STORY 97, across the elevator's approach: it
    // warps to MAP_TOUR_NEBULA_1F (no warp event; Ch10's elevator sign covers later rides).
    Coord(x: 11, y: 3, var: "VAR_SIL_STORY", value: 97, script: "Nebula_TourHall_Sc02"),
    Coord(x: 12, y: 3, var: "VAR_SIL_STORY", value: 97, script: "Nebula_TourHall_Sc02"),
    Coord(x: 13, y: 3, var: "VAR_SIL_STORY", value: 97, script: "Nebula_TourHall_Sc02"),
    // 1: Sbire 3 (sas 1), his sight across V1's whole width at row 12.
    // 2-3: Viktor (sas 2, facing down from his niche) and Nadia (facing up), each across H's whole height.
    // 4: Kroll (sas 3), across V2 at row 6; his after-battle script sets VAR_SIL_STORY 97.
    Object(x: 18, y: 12, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_TOUR_HALL_SBIRE_3", local_id: 1, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Nebula_TourHall_EventScript_Sbire3", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 16, y: 8, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_TOUR_HALL_VIKTOR", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Nebula_TourHall_EventScript_Viktor", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 15, y: 11, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_TOUR_HALL_NADIA", local_id: 3, movement: "MOVEMENT_TYPE_FACE_UP", script: "Nebula_TourHall_EventScript_Nadia", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 14, y: 6, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_TOUR_HALL_KROLL", local_id: 4, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Nebula_TourHall_EventScript_Kroll", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    // bg 0-2: the windows on the Grande Porte (Tour_Hall_Vitre).
    Sign(x: 1, y: 12, script: "Nebula_TourHall_EventScript_Vitre"),
    Sign(x: 1, y: 13, script: "Nebula_TourHall_EventScript_Vitre"),
    Sign(x: 1, y: 14, script: "Nebula_TourHall_EventScript_Vitre"),
    // bg 3-4: the screen wall (Nebula_Hall_Ecran).
    Sign(x: 6, y: 11, script: "Nebula_TourHall_EventScript_Ecran"),
    Sign(x: 7, y: 11, script: "Nebula_TourHall_EventScript_Ecran"),
    // bg 5: the empty reception (Nebula_Hall_Accueil).
    Sign(x: 9, y: 13, script: "Nebula_TourHall_EventScript_Accueil"),
    // bg 6: the elevator door: before 97 shut; Ch10's rides to the floor reached (Tour_Ascenseur).
    Sign(x: 12, y: 1, script: "Nebula_TourHall_EventScript_Ascenseur"),
    // bg 7: hidden Hyper Potion on the reception counter.
    HiddenItem(x: 10, y: 13, item: "ITEM_HYPER_POTION", flag: "FLAG_SIL_ITEM_TOUR_HALL_ACCUEIL"),
]

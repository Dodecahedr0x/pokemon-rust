// Header, map scripts, warps, objects, coord and bg events.
[
    Header((music: "MUS_AQUA_MAGMA_HIDEOUT", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnLoad: the tubes drawn lit or dark from VAR_SIL_STATION_STATE, the foreman moved to (8, 5)
    // once FLAG_SIL_STATION_CONTREMAITRE. OnTransition: FLAG_TEMP_1 mirrors
    // FLAG_SIL_HIDE_STATION_SBIRES for sbire 2.
    Scripts((on_load: Some("ViberCity_StationLumiere_OnLoad"), on_transition: Some("ViberCity_StationLumiere_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the entry (7, 11), to Viber-City's warp 2 (the Station door).
    Warp(x: 7, y: 11, dest_map: "ViberCity", dest_warp: 2),
    // Objects 1-4: sbire 1, sbire 2, the technician, the foreman (the source's obj 4).
    Object(x: 2, y: 9, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_STATION_SBIRE_1", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ViberCity_StationLumiere_EventScript_Sbire1", flag: "FLAG_SIL_HIDE_STATION_SBIRES", trainer_type: "TRAINER_TYPE_NORMAL", sight: 4),
    Object(x: 3, y: 5, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_STATION_SBIRE_2", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ViberCity_StationLumiere_EventScript_Sbire2", flag: "FLAG_TEMP_1", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 13, y: 6, gfx: "OBJ_EVENT_GFX_SCIENTIST_2", id: "LOCALID_STATION_TECHNICIENNE", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "ViberCity_StationLumiere_EventScript_Technicienne", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 7, y: 5, gfx: "OBJ_EVENT_GFX_MAN_4", id: "LOCALID_STATION_CONTREMAITRE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_StationLumiere_Sc01"),
    Object(x: 4, y: 7, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_STATION_ITEM_ELIXIR", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ViberCity_StationLumiere_EventScript_ItemElixir", flag: "FLAG_SIL_ITEM_STATION_ELIXIR"),
    // Leaving the fuse room resets the tubes: the doorway (7, 4) on VAR_TEMP_3 (never set here).
    Coord(x: 7, y: 4, var: "VAR_TEMP_3", value: 0, script: "ViberCity_StationLumiere_EventScript_SortieFusibles"),
    // Station_Lumiere_Sc02: the levers (read from y 2), the reset lever R (10, 2) is a desk object
    // in the source; here a crate cell read from (9, 2) or (10, 3).
    Sign(x: 5, y: 1, script: "ViberCity_StationLumiere_EventScript_Levier1"),
    Sign(x: 6, y: 1, script: "ViberCity_StationLumiere_EventScript_Levier2"),
    Sign(x: 7, y: 1, script: "ViberCity_StationLumiere_EventScript_Levier3"),
    Sign(x: 8, y: 1, script: "ViberCity_StationLumiere_EventScript_Levier4"),
    Sign(x: 9, y: 1, script: "ViberCity_StationLumiere_EventScript_Tube"),
    Sign(x: 10, y: 1, script: "ViberCity_StationLumiere_EventScript_Tube"),
    Sign(x: 11, y: 1, script: "ViberCity_StationLumiere_EventScript_Tube"),
    Sign(x: 11, y: 2, script: "ViberCity_StationLumiere_EventScript_LevierR"),
    // The notice desk: the source's (7, 10) stands right in front of the entry, so (9, 10).
    Sign(x: 9, y: 10, script: "ViberCity_StationLumiere_EventScript_Note"),
    Sign(x: 2, y: 6, script: "ViberCity_StationLumiere_EventScript_Transfo"),
    Sign(x: 5, y: 6, script: "ViberCity_StationLumiere_EventScript_Transfo"),
    Sign(x: 8, y: 6, script: "ViberCity_StationLumiere_EventScript_Transfo"),
    Sign(x: 11, y: 6, script: "ViberCity_StationLumiere_EventScript_Transfo"),
]

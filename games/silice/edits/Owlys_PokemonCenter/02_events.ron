// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_POKE_CENTER", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Owlys_PokemonCenter_OnTransition sets the respawn point (HEAL_LOCATION_OWLYS, also Fly's
    // destination).
    Scripts((on_load: None, on_transition: Some("Owlys_PokemonCenter_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps 0-1: the mat, to Owlys's warp 2.
    Warp(x: 5, y: 7, dest_map: "Owlys", dest_warp: 2),
    Warp(x: 6, y: 7, dest_map: "Owlys", dest_warp: 2),
    // Objects. 1: the nurse (the lamps remark). 2: the shop clerk (the Center's shop). 3: a trainer.
    Object(x: 6, y: 2, gfx: "OBJ_EVENT_GFX_NURSE", id: "LOCALID_OWLYS_PC_NURSE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Owlys_PokemonCenter_EventScript_Nurse"),
    Object(x: 3, y: 2, gfx: "OBJ_EVENT_GFX_MART_EMPLOYEE", id: "LOCALID_OWLYS_PC_CLERK", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Owlys_PokemonCenter_EventScript_Clerk"),
    Object(x: 9, y: 5, gfx: "OBJ_EVENT_GFX_GENTLEMAN", id: "LOCALID_OWLYS_PC_PELERIN", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Owlys_PokemonCenter_EventScript_Pelerin"),
]

// Cells, then SilPortRessacGym's stamps (games/silice/gfx/SilPortRessacGym.ron, original art).
// Quarterdeck (rows 1-7): the deckhouse over the ladder from the hold (door (5, 4)), the helm (13, 2)
// behind Samuel, rum barrels. Its front wall (rows 8-9) with the stairs (9-10, 8-9), barred at the deck
// by a grille (9-10, 10). Main deck: the great mast (5, 11-13), the hatch deckhouse (door (13, 13)) down
// to the hold, barrels by the rails. South: the rail, the hull and the gangway stairs (9-10, 19-20) and
// the exit steps (9-10, 21). The sea round the hull: water, solid (decor).
[
    Ascii(x: 0, y: 0, rows: [
        "~~~~~~~~~~~~~~~~~~~~",
        "~~----------------~~",
        "~~|..........B.uu!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~-------..-------~~",
        "~~WWWWWW....WWWWWW~~",
        "~~FFFFFF....FFFFFF~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|..............!~~",
        "~~|u.............!~~",
        "~~|u............u!~~",
        "~~|.............u!~~",
        "~~-------..-------~~",
        "~~HHHHHH....HHHHHH~~",
        "~~IIIIII....IIIIII~~",
        "~~KKKKKK....KKKKKK~~",
    ], legend: {
        '~': (metatile: 368, collision: 1),
        '.': (metatile: 512, collision: 0),
        '-': (metatile: 518, collision: 1),
        '|': (metatile: 519, collision: 1),
        '!': (metatile: 520, collision: 1),
        'W': (metatile: 513, collision: 1),
        'F': (metatile: 514, collision: 1),
        'H': (metatile: 515, collision: 1),
        'I': (metatile: 516, collision: 1),
        'K': (metatile: 517, collision: 1),
        'B': (metatile: 547, collision: 1),
        'u': (metatile: 548, collision: 1),
    }),
    // The quarterdeck deckhouse, x 4-6, y 2-4, door (5, 4) (the hold's ladder comes up there).
    Stamp(x: 4, y: 2, name: "SilPortRessacGym_cabine"),
    // The quarterdeck stairs, x 8-11, y 8-9 (steps 9-10), and their grille (9-10, 10): the deck's planks
    // (METATILE_PONT, ch04_gym.rs) once opened.
    Stamp(x: 8, y: 8, name: "SilPortRessacGym_escalier"),
    Stamp(x: 9, y: 10, name: "SilPortRessacGym_grille"),
    // The great mast (5, 11-13) and the hatch deckhouse, x 12-14, y 11-13, door (13, 13).
    Stamp(x: 5, y: 11, name: "SilPortRessacGym_mat"),
    Stamp(x: 12, y: 11, name: "SilPortRessacGym_cabine"),
    // The gangway: stairs down the hull (9-10, 19-20), the exit steps (9-10, 21).
    Stamp(x: 8, y: 19, name: "SilPortRessacGym_escalier"),
    Stamp(x: 8, y: 21, name: "SilPortRessacGym_sortie"),
]

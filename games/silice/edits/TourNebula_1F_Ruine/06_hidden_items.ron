// running the `hidden_item` fallback.
[
    Replace(index: 0, event: Bg((x: 12, y: 9, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_RHUM_PIRATE", flag: "FLAG_SIL_ITEM_PG_RUINE1_RHUM")))),
]

// SIL3 Ch5 scripts: the map changes the Chapter 5 scripts need.
[
    // Owlys_Entrepot_B1F_OnLoad keeps the Poudre Claire sacks gone once emptied (FLAG_SIL_OWLYS_SILO_VIDE).
    ScriptsSet(on_load: "Owlys_Entrepot_B1F_OnLoad"),
    // The Silo Chief leaves after his battle (Owlys_Entrepot_B1F_Sc02 hides him) and must stay gone: the
    // object had no hide flag, so he came back as soon as his cell scrolled into view (the gap he
    // guards is the reserve's only way out). His hide flag is FLAG_SIL_OWLYS_SILO_DECIDE, the scene's
    // own flag (set by that same hide, then by the choice): no new flag (the flags block has none
    // free in the requested range). Object 3 as 02_events.ron places it, plus the flag.
    Replace(index: 3, event: Object((local_id: 4, id: Some("LOCALID_SILO_CHEF"), gfx: "OBJ_EVENT_GFX_MAN_3", x: 27, y: 26, elevation: 3, movement: "MOVEMENT_TYPE_FACE_UP", range_x: 0, range_y: 0, trainer_type: "TRAINER_TYPE_NORMAL", trainer_sight_or_berry_tree: 2, script: Some("Owlys_Entrepot_B1F_Sc02"), flag: Some("FLAG_SIL_OWLYS_SILO_DECIDE")))),
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 0, event: Bg((x: 31, y: 2, elevation: 0, kind: HiddenItem(item: "ITEM_IRON", flag: "FLAG_SIL_ITEM_OWLYS_SILO_FER")))).
    Replace(index: 0, event: Bg((x: 31, y: 2, elevation: 0, kind: Script(facing: 0, script: Some("Owlys_Entrepot_B1F_EventScript_HiddenIron"))))),
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 1, event: Bg((x: 9, y: 24, elevation: 0, kind: HiddenItem(item: "ITEM_ZINC", flag: "FLAG_SIL_ITEM_OWLYS_SILO_ZINC")))).
    Replace(index: 1, event: Bg((x: 9, y: 24, elevation: 0, kind: Script(facing: 0, script: Some("Owlys_Entrepot_B1F_EventScript_HiddenZinc"))))),
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 2, event: Bg((x: 15, y: 3, elevation: 0, kind: HiddenItem(item: "ITEM_CALCIUM", flag: "FLAG_SIL_ITEM_OWLYS_SILO_CALCIUM")))).
    Replace(index: 2, event: Bg((x: 15, y: 3, elevation: 0, kind: Script(facing: 0, script: Some("Owlys_Entrepot_B1F_EventScript_HiddenCalcium"))))),
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 3, event: Bg((x: 15, y: 14, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_PIERRE_LIEN", flag: "FLAG_SIL_ITEM_OWLYS_SILO_PIERRE_LIEN")))).
    Replace(index: 3, event: Bg((x: 15, y: 14, elevation: 0, kind: Script(facing: 0, script: Some("Owlys_Entrepot_B1F_EventScript_HiddenPierreLien"))))),
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 4, event: Bg((x: 33, y: 27, elevation: 0, kind: HiddenItem(item: "ITEM_SIL_SABLENITE", flag: "FLAG_SIL_ITEM_OWLYS_SILO_SABLENITE")))).
    Replace(index: 4, event: Bg((x: 33, y: 27, elevation: 0, kind: Script(facing: 0, script: Some("Owlys_Entrepot_B1F_EventScript_HiddenSablenite"))))),
]

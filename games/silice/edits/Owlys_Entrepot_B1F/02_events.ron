// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_AQUA_MAGMA_HIDEOUT", region_map_section: "MAPSEC_NONE", cave: 1, weather: "WEATHER_NONE", map_type: "MAP_TYPE_UNDERGROUND", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // cave: 1 makes it dark until Flash; the engine does not draw darkness yet.
    // Map scripts: Owlys_Entrepot_B1F_OnTransition sets the three Umbreon's hide flags (they only appear in the
    // junction scenes).
    Scripts((on_load: None, on_transition: Some("Owlys_Entrepot_B1F_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the freight lift, to the ground floor's warp 2.
    Warp(x: 17, y: 1, dest_map: "Owlys_Entrepot", dest_warp: 2),
    // Objects 1-3: the Umbreon, one per junction (the source's numbers), hidden; each walks three cells
    // the right way. 4: the Silo Chief (TRAINER_SIL_OWLYS_CHEF_SILO), by the reserve.
    Object(x: 14, y: 7, gfx: "OBJ_EVENT_GFX_POOCHYENA", id: "LOCALID_SILO_NOCTALI_1", local_id: 1, movement: "MOVEMENT_TYPE_FACE_LEFT", flag: "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_1"),
    Object(x: 5, y: 16, gfx: "OBJ_EVENT_GFX_POOCHYENA", id: "LOCALID_SILO_NOCTALI_2", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_2"),
    Object(x: 7, y: 23, gfx: "OBJ_EVENT_GFX_POOCHYENA", id: "LOCALID_SILO_NOCTALI_3", local_id: 3, movement: "MOVEMENT_TYPE_FACE_RIGHT", flag: "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_3"),
    Object(x: 28, y: 25, gfx: "OBJ_EVENT_GFX_MAN_3", id: "LOCALID_SILO_CHEF", local_id: 4, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Owlys_Entrepot_B1F_Sc02"),
    // Owlys_Entrepot_B1F_Sc01_1-3 (the source's Owlys_Entrepot_Sc01, one per junction): coord events on
    // the cells leading into each junction, on VAR_TEMP_1 0 (every map load). Each checks its
    // FLAG_SIL_OWLYS_SILO_NOCTALI_n first.
    Coord(x: 16, y: 5, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_1"),
    Coord(x: 17, y: 5, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_1"),
    Coord(x: 18, y: 5, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_1"),
    Coord(x: 4, y: 13, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_2"),
    Coord(x: 5, y: 13, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_2"),
    Coord(x: 4, y: 21, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_3"),
    Coord(x: 5, y: 21, var: "VAR_TEMP_1", value: 0, script: "Owlys_Entrepot_B1F_Sc01_3"),
    // Hidden items: Iron (the north nook), Zinc (behind a tank by junction 3), Calcium (by the lift's
    // landing), the Link Stone (on the processor crate at junction 2's dead end), the Sablenite (in a cracked
    // tank behind the reserve).
    HiddenItem(x: 31, y: 2, item: "ITEM_IRON", flag: "FLAG_SIL_ITEM_OWLYS_SILO_FER"),
    HiddenItem(x: 9, y: 24, item: "ITEM_ZINC", flag: "FLAG_SIL_ITEM_OWLYS_SILO_ZINC"),
    HiddenItem(x: 15, y: 3, item: "ITEM_CALCIUM", flag: "FLAG_SIL_ITEM_OWLYS_SILO_CALCIUM"),
    HiddenItem(x: 15, y: 14, item: "ITEM_SIL_PIERRE_LIEN", flag: "FLAG_SIL_ITEM_OWLYS_SILO_PIERRE_LIEN"),
    HiddenItem(x: 33, y: 25, item: "ITEM_SIL_SABLENITE", flag: "FLAG_SIL_ITEM_OWLYS_SILO_SABLENITE"),
]

// SIL4 Ch8 scripts: the map changes the Chapter 8 scripts need.
[
    // The Champ Magnétique fallback (as Ch3-Ch4's blocks): the engine pushes no boulder, so an A press
    // on an iron crate runs Evalon_TourScribe_2F_EventScript_Caisse, which moves it one cell the way the
    // player faces. The objects as 02_events.ron places them, plus the script.
    Replace(index: 0, event: Object((local_id: 1, id: Some("LOCALID_TOUR2_CAISSE_A"), gfx: "OBJ_EVENT_GFX_PUSHABLE_BOULDER", x: 5, y: 5, elevation: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", range_x: 0, range_y: 0, trainer_type: "TRAINER_TYPE_NONE", trainer_sight_or_berry_tree: 0, script: Some("Evalon_TourScribe_2F_EventScript_Caisse"), flag: None))),
    Replace(index: 1, event: Object((local_id: 2, id: Some("LOCALID_TOUR2_CAISSE_B"), gfx: "OBJ_EVENT_GFX_PUSHABLE_BOULDER", x: 7, y: 5, elevation: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", range_x: 0, range_y: 0, trainer_type: "TRAINER_TYPE_NONE", trainer_sight_or_berry_tree: 0, script: Some("Evalon_TourScribe_2F_EventScript_Caisse"), flag: None))),
    Replace(index: 2, event: Object((local_id: 3, id: Some("LOCALID_TOUR2_CAISSE_C"), gfx: "OBJ_EVENT_GFX_PUSHABLE_BOULDER", x: 5, y: 7, elevation: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", range_x: 0, range_y: 0, trainer_type: "TRAINER_TYPE_NONE", trainer_sight_or_berry_tree: 0, script: Some("Evalon_TourScribe_2F_EventScript_Caisse"), flag: None))),
    Replace(index: 3, event: Object((local_id: 4, id: Some("LOCALID_TOUR2_CAISSE_D"), gfx: "OBJ_EVENT_GFX_PUSHABLE_BOULDER", x: 8, y: 8, elevation: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", range_x: 0, range_y: 0, trainer_type: "TRAINER_TYPE_NONE", trainer_sight_or_berry_tree: 0, script: Some("Evalon_TourScribe_2F_EventScript_Caisse"), flag: None))),
]

// Cells, drawn in one grid, then SilEvalonCitadelle's stamps (games/silice/gfx/SilEvalonCitadelle.ron,
// original art): the Salle du Trone. Legend (char: metatile/collision/elevation, what):
//   # 1/1/0 void (Building's black)
//   . 512/0/3 flagstones
//   F 514/1/0 wall face
//   W 513/1/0 wall top
//   c 567/0/3 carpet
//   u 532/0/3 flagstones in the wall's shadow
[
    Ascii(x: 0, y: 0, rows: [
        "WWWWWWWWWWWW",
        "FFFFFFFFFFFF",
        "uuuuuuuuuuuu",
        "............",
        "............",
        "............",
        ".....cc.....",
        ".....cc.....",
        ".....cc.....",
        ".....cc.....",
        ".....cc.....",
        "#####..#####",
    ], legend: {'#': (metatile: 1, collision: 1, elevation: 0), '.': (metatile: 512, collision: 0, elevation: 3), 'F': (metatile: 514, collision: 1, elevation: 0), 'W': (metatile: 513, collision: 1, elevation: 0), 'c': (metatile: 567, collision: 0, elevation: 3), 'u': (metatile: 532, collision: 0, elevation: 3)}),
    // The giant game table (4-7, 2-4): Loulpix and Doris sit at its south side (5-6, 5).
    Stamp(x: 4, y: 2, name: "SilEvalonCitadelle_table_jeu"),
    // The factions' banners and torches on the north wall.
    Stamp(x: 2, y: 0, name: "SilEvalonCitadelle_banniere_bleue"),
    Stamp(x: 9, y: 0, name: "SilEvalonCitadelle_banniere_verte"),
    Stamp(x: 0, y: 0, name: "SilEvalonCitadelle_torche"),
    Stamp(x: 11, y: 0, name: "SilEvalonCitadelle_torche"),
    // Suits of armour along the carpet (as the Pike's knight statues were).
    Stamp(x: 2, y: 5, name: "SilEvalonCitadelle_armure"),
    Stamp(x: 9, y: 5, name: "SilEvalonCitadelle_armure"),
    Stamp(x: 2, y: 8, name: "SilEvalonCitadelle_armure"),
    Stamp(x: 9, y: 8, name: "SilEvalonCitadelle_armure"),
    // Gold heaps in the corners.
    Stamp(x: 0, y: 10, name: "SilEvalonCitadelle_tresor"),
    Stamp(x: 11, y: 10, name: "SilEvalonCitadelle_tresor"),
    // The stairs down (5-6, 11), south arrow warps (warps 0-1).
    Stamp(x: 5, y: 11, name: "SilEvalonCitadelle_escalier_bas"),
]

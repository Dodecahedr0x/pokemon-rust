    Object(x: 2, y: 7, gfx: "OBJ_EVENT_GFX_SCHOOL_KID_M", id: "LOCALID_GARGOTE_ADRIEN", local_id: 2, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Nebula_Gargote_EventScript_Adrien", flag: "FLAG_SIL_HIDE_NEBULA_GARGOTE_ADRIEN"),
    Object(x: 5, y: 7, gfx: "OBJ_EVENT_GFX_BOY_2", id: "LOCALID_GARGOTE_GWADA", local_id: 3, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Nebula_Gargote_EventScript_Gwada", flag: "FLAG_SIL_HIDE_NEBULA_GARGOTE_GWADA"),
    // 4: Mme Fenouil at the end of her counter (Fenouil_T1; the Leftovers after Sc02, FLAG_SIL_ITEM_NEBULA_RESTES).
    Object(x: 4, y: 4, gfx: "OBJ_EVENT_GFX_WOMAN_5", id: "LOCALID_GARGOTE_FENOUIL", local_id: 4, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Nebula_Gargote_EventScript_Fenouil"),

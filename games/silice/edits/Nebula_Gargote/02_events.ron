// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_LILYCOVE_MUSEUM", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // On-frame at VAR_SIL_STORY 93: Nebula_Gargote_Sc02 (le conseil de guerre; it sets 94).
    Scripts((on_load: None, on_transition: None, on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [(var: "VAR_SIL_STORY", value: 93, script: "Nebula_Gargote_Sc02")], on_warp_into: [])),
    // Warps 0-1: the mat, to Nebula's warp 2 (the Gargote's door).
    Warp(x: 5, y: 9, dest_map: "Nebula", dest_warp: 2),
    Warp(x: 6, y: 9, dest_map: "Nebula", dest_warp: 2),
    // 1-3: the friends (the source's obj 1-3), each with its own hide flag; Nebula_Sc03 sets all

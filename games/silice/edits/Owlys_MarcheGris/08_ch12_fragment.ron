    Sign(x: 6, y: 4, script: "Owlys_MarcheGris_PG_Fragment"),
    Coord(x: 6, y: 6, var: "VAR_TEMP_1", value: 0, script: "Owlys_MarcheGris_PG_FragmentBip"),
    Coord(x: 4, y: 4, var: "VAR_TEMP_1", value: 0, script: "Owlys_MarcheGris_PG_FragmentBip"),
]

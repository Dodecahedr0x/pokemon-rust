        "M...a....e...M",
        "M............M",
        "M............M",
        "MMMMMM...MMMMM",
        "M............M",
        "M............M",
        "MMMMMM.MMMMMMM",
        "MMFlFF.MFMFMMM",
        "MMiiiiipipiMMM",
        "MMipiiiiiiiMMM",

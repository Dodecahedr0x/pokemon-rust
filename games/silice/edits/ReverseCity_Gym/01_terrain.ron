    // The great mirror that shows no reflection, where Reverse stands with his back to the player.
    Stamp(x: 5, y: 1, name: "SilReverseCityGym_grand_miroir"),
    // The three lying mirror doors (left, middle, right); their walkable bottom row holds the door coords.
    Stamp(x: 2, y: 12, name: "SilReverseCityGym_porte_miroir"),

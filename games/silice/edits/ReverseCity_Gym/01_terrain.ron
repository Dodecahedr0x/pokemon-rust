    ], legend: {
        'M': (metatile: 533, collision: 1),
        'F': (metatile: 534, collision: 1),
        'l': (metatile: 539, collision: 1),
        '.': (metatile: 532, collision: 0),
        'i': (metatile: 535, collision: 0),
        'p': (metatile: 536, collision: 1),

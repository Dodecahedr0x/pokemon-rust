// Header, map scripts, warps, objects, coord and bg events.
[
    Header((music: "MUS_GYM", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // ReverseCity_Gym_OnTransition: set_input_inverted(!FLAG_SIL_REVERSE_BATTU), the hide flags.
    // Gym_Sc02 chains from Gym_Sc01; the on-frame entry replays it if the story stopped at 74.
    Scripts((on_load: None, on_transition: Some("ReverseCity_Gym_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [(var: "VAR_SIL_STORY", value: 74, script: "ReverseCity_Gym_Sc02")], on_warp_into: [])),
    // Warps 0-1: the mat, to Reverse-City's warp 7 (the Palais door). Warps 2 and 3 are arrival points
    // for the door scripts (warp(MAP_REVERSE_CITY_GYM, 2) to the S tapis, 3 to room 3); they point at
    // each other and are never stepped on as warps.
    Warp(x: 6, y: 36, dest_map: "ReverseCity", dest_warp: 7),
    Warp(x: 7, y: 36, dest_map: "ReverseCity", dest_warp: 7),
    Warp(x: 6, y: 29, dest_map: "ReverseCity_Gym", dest_warp: 3),
    Warp(x: 6, y: 10, dest_map: "ReverseCity_Gym", dest_warp: 2),
    Object(x: 6, y: 4, gfx: "OBJ_EVENT_GFX_JUAN", id: "LOCALID_GYM07_REVERSE", local_id: 1, movement: "MOVEMENT_TYPE_FACE_UP", script: "ReverseCity_Gym_Sc01", flag: "FLAG_SIL_HIDE_GYM07_REVERSE"),
    Object(x: 9, y: 4, gfx: "OBJ_EVENT_GFX_SCIENTIST_1", id: "LOCALID_GYM07_BENOU", local_id: 2, movement: "MOVEMENT_TYPE_FACE_LEFT", flag: "FLAG_SIL_HIDE_GYM07_BENOU"),
    Object(x: 4, y: 32, gfx: "OBJ_EVENT_GFX_MAN_2", id: "LOCALID_GYM07_GUIDE", local_id: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_Gym_EventScript_Guide"),
    Object(x: 3, y: 19, gfx: "OBJ_EVENT_GFX_BEAUTY", id: "LOCALID_GYM07_ANNA", local_id: 4, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ReverseCity_Gym_EventScript_Anna", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 8, y: 16, gfx: "OBJ_EVENT_GFX_ARTIST", id: "LOCALID_GYM07_XELA", local_id: 5, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "ReverseCity_Gym_EventScript_Xela", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 4, y: 8, gfx: "OBJ_EVENT_GFX_PSYCHIC_M", id: "LOCALID_GYM07_NOMIS", local_id: 6, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "ReverseCity_Gym_EventScript_Nomis", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 6, y: 4, gfx: "OBJ_EVENT_GFX_KECLEON_BRIDGE_SHADOW", id: "LOCALID_GYM07_PIXELS_NOIRS", local_id: 9, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_GYM07_PIXELS"),
    // The mirror doors: their walkable bottom cells run the door scripts on every step (VAR_TEMP_1 stays 0;
    // no script on this map writes it). The tileset has no door or warp-pad metatile.
    Coord(x: 2, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteGauche"),
    Coord(x: 3, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteGauche"),
    Coord(x: 6, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteMilieu"),
    Coord(x: 7, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteMilieu"),
    Coord(x: 10, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteDroite"),
    Coord(x: 11, y: 14, var: "VAR_TEMP_1", value: 0, script: "ReverseCity_Gym_EventScript_PorteDroite"),
    // Gym_Sc01: the three cells behind Reverse, the only way to him.
    Coord(x: 5, y: 5, var: "VAR_SIL_STORY", value: 73, script: "ReverseCity_Gym_Sc01"),
    Coord(x: 6, y: 5, var: "VAR_SIL_STORY", value: 73, script: "ReverseCity_Gym_Sc01"),
    Coord(x: 7, y: 5, var: "VAR_SIL_STORY", value: 73, script: "ReverseCity_Gym_Sc01"),
    Sign(x: 5, y: 20, script: "ReverseCity_Gym_EventScript_SignRegle"),
    Sign(x: 4, y: 14, script: "ReverseCity_Gym_EventScript_Statue1"),
    Sign(x: 9, y: 14, script: "ReverseCity_Gym_EventScript_Statue2"),
    HiddenItem(x: 2, y: 25, item: "ITEM_LUM_BERRY", flag: "FLAG_SIL_ITEM_GYM07_LUM_BERRY"),
    HiddenItem(x: 6, y: 4, item: "ITEM_SIL_ALAKAZITE", flag: "FLAG_SIL_ITEM_GYM07_ALAKAZITE"),
]

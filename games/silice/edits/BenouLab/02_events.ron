// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_BIRCH_LAB", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Warps 0-1: the mats, back to Nebula's MAINTENANCE door (its warp 4). Warp 2: the teleporter behind the
    // blast door, to the Zone 404 (its warp 0).
    Warp(x: 6, y: 10, dest_map: "Nebula", dest_warp: 4),
    Warp(x: 7, y: 10, dest_map: "Nebula", dest_warp: 4),
    Warp(x: 6, y: 1, dest_map: "Zone404", dest_warp: 0),
    // 1: Benou at his desk (BenouLab_PG_Sc23, the Architect battle). 2: the blast door on the teleporter's
    // front cell, until FLAG_SIL_ZONE404_OUVERTE (set by the scene that opens the Zone 404) hides it.
    Object(x: 6, y: 4, gfx: "OBJ_EVENT_GFX_SIL_BENOU", id: "LOCALID_BENOU_LAB_BENOU", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BenouLab_PG_Sc23"),
    Object(x: 6, y: 2, gfx: "OBJ_EVENT_GFX_TRICK_HOUSE_STATUE", id: "LOCALID_BENOU_LAB_PORTE", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "BenouLab_EventScript_Porte", flag: "FLAG_SIL_ZONE404_OUVERTE"),
    // The PC of the original logs (BenouLab_PG_Sc24, from FLAG_SIL_BENOU_BATTU), the cork board of the
    // Mallette's diagrams, and the blast door's sign ('NE PAS OUVRIR (SERIEUX)').
    Sign(x: 1, y: 2, script: "BenouLab_PG_Sc24"),
    Sign(x: 3, y: 1, script: "BenouLab_EventScript_Tableau"),
    Sign(x: 7, y: 1, script: "BenouLab_EventScript_PanneauPorte"),
]

    // engine picks hidden items up: Replace(index: 2, event: Bg((x: 43, y: 22, elevation: 0, kind: HiddenItem(item: "ITEM_HEART_SCALE", flag: "FLAG_SIL_ITEM_ROUTE_S05_ECAILLE_COEUR")))).
    Replace(index: 2, event: Bg((x: 43, y: 22, elevation: 0, kind: Script(facing: 0, script: Some("RouteS05_EventScript_HiddenHeartScale"))))),
]

    Coord(x: 22, y: 11, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    // The origami boats (the bearings), the entrance sign, the screens' slogan, the closed elevator door D.
    Sign(x: 3, y: 14, script: "TourNebula_3F_EventScript_Origami1"),
    Sign(x: 10, y: 14, script: "TourNebula_3F_EventScript_Origami2"),
    Sign(x: 18, y: 14, script: "TourNebula_3F_EventScript_Origami3"),

    Sign(x: 11, y: 16, script: "TourNebula_3F_EventScript_PorteVerrouillee"),
    // The Full Restore, at the quay's right end.
    HiddenItem(x: 22, y: 13, item: "ITEM_FULL_RESTORE", flag: "FLAG_SIL_ITEM_TOUR_3F_FULL_RESTORE"),

    Coord(x: 10, y: 9, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 12, y: 9, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 10, y: 10, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 12, y: 10, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),

// Header, map scripts, warps, objects, coord and bg events.
[
    // Music: the source's new "Horizon virtuel" theme; placeholder MUS_UNDERWATER, the source's. It rains all
    // the time (the source's Route 120 rain fallback): WEATHER_RAIN, so every battle here starts in rain.
    Header((music: "MUS_UNDERWATER", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_RAIN", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // TourNebula_3F_OnLoad: opens the screen behind Arthur (12, 1) from VAR_SIL_STORY 105 (collision 0).
    ScriptsSet(on_load: "TourNebula_3F_OnLoad"),
    // Warp 0: the arrival (11, 15), a landing. Warp 1: the screen behind Arthur (12, 1), to the cabin (the
    // source's (11, 1) would be behind Arthur himself, who stands on (11, 2)).
    Warp(x: 11, y: 15, dest_map: "TourNebulaAscenseur", dest_warp: 2),
    Warp(x: 12, y: 1, dest_map: "TourNebulaAscenseur", dest_warp: 2),
    // Objects (the source's numbers). 1: Arthur at the helm (TourNebula_3F_Sc04 at story 104; it plays _Sc05
    // from 105). 2-3: the elites Yann (sailor) and Maelle (lookout) on the quay, sight 4 along it. 4: the
    // compass on the lectern (TourNebula_3F_Sc02; FLAG_SIL_HIDE_ARTHUR_BOUSSOLE, the source's). 5: the
    // technician. 6: the Cocket cabin boy.
    Object(x: 11, y: 2, gfx: "OBJ_EVENT_GFX_SAILOR", id: "LOCALID_TOUR_3F_ARTHUR", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "TourNebula_3F_Sc04"),
    Object(x: 3, y: 13, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_TOUR_3F_YANN", local_id: 2, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "TourNebula_3F_EventScript_Yann", trainer_type: "TRAINER_TYPE_NORMAL", sight: 4),
    Object(x: 16, y: 13, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_TOUR_3F_MAELLE", local_id: 3, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "TourNebula_3F_EventScript_Maelle", trainer_type: "TRAINER_TYPE_NORMAL", sight: 4),
    Object(x: 8, y: 13, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_TOUR_3F_BOUSSOLE", local_id: 4, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "TourNebula_3F_Sc02", flag: "FLAG_SIL_HIDE_ARTHUR_BOUSSOLE"),
    Object(x: 20, y: 15, gfx: "OBJ_EVENT_GFX_SCIENTIST_1", id: "LOCALID_TOUR_3F_TECHNICIEN", local_id: 5, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "TourNebula_3F_EventScript_Technicien"),
    Object(x: 5, y: 15, gfx: "OBJ_EVENT_GFX_BOY_3", id: "LOCALID_TOUR_3F_MOUSSE", local_id: 6, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "TourNebula_3F_EventScript_Mousse"),
    // TourNebula_3F_Sc01 (the Horizon): the arrival's three ways off (the source puts it on the arrival
    // (11, 15), which fires no coord event). On VAR_TEMP_1 0; the script sets VAR_TEMP_1 to 1 and returns at
    // once when FLAG_SIL_TOUR_3F_INTRO is set.
    Coord(x: 11, y: 14, var: "VAR_TEMP_1", value: 0, script: "TourNebula_3F_Sc01"),
    Coord(x: 10, y: 15, var: "VAR_TEMP_1", value: 0, script: "TourNebula_3F_Sc01"),
    Coord(x: 12, y: 15, var: "VAR_TEMP_1", value: 0, script: "TourNebula_3F_Sc01"),
    // TourNebula_3F_Sc03 (falling in, story 104): every sea cell next to the quay, the path or the platform
    // (46 cells; "Plouf!", back to the quay (11, 14)). From 105 the sea is off: the cells stay walkable.
    Coord(x: 8, y: 2, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 14, y: 2, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 8, y: 3, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 14, y: 3, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 9, y: 4, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),
    Coord(x: 10, y: 4, var: "VAR_SIL_STORY", value: 104, script: "TourNebula_3F_Sc03"),

// Header, warps, objects, coord and bg events. ADRIEN is the source's obj 1.
[
    // The servers' hum near the archives is a script sound (play_se), not a map setting.
    Header((music: "MUS_LILYCOVE_MUSEUM", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // The entrance mat, to Manga-Square's warp 0 (the pagoda's door).
    Warp(x: 12, y: 23, dest_map: "MangaSquare", dest_warp: 0),
    Warp(x: 13, y: 23, dest_map: "MangaSquare", dest_warp: 0),
    // ADRIEN at his reading desk (x 13-14, y 5-6), at the back, left of the Salle des Archives.
    Object(x: 13, y: 4, gfx: "OBJ_EVENT_GFX_SCHOOL_KID_M", id: "LOCALID_BIBLIO_ADRIEN", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Bibliotheque_Sc01", flag: "FLAG_SIL_HIDE_BIBLIO_ADRIEN"),
    Object(x: 17, y: 16, gfx: "OBJ_EVENT_GFX_OLD_WOMAN", id: "LOCALID_BIBLIO_ARCHIVISTE", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Bibliotheque_EventScript_Archiviste"),
    Object(x: 20, y: 6, gfx: "OBJ_EVENT_GFX_SCIENTIST_1", id: "LOCALID_BIBLIO_PRESTATAIRE", local_id: 3, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "MangaSquare_Bibliotheque_EventScript_Prestataire"),
    Object(x: 7, y: 14, gfx: "OBJ_EVENT_GFX_BOY_1", id: "LOCALID_BIBLIO_ETUDIANT", local_id: 4, movement: "MOVEMENT_TYPE_FACE_UP", script: "MangaSquare_Bibliotheque_EventScript_Etudiant"),
    // Bibliotheque_Sc01: the row before ADRIEN's desk (two cells from him; VAR_SIL_STORY == 63), from the
    // shelves to the partition.
    Coord(x: 12, y: 7, var: "VAR_SIL_STORY", value: 63, script: "MangaSquare_Bibliotheque_Sc01"),
    Coord(x: 13, y: 7, var: "VAR_SIL_STORY", value: 63, script: "MangaSquare_Bibliotheque_Sc01"),
    Coord(x: 14, y: 7, var: "VAR_SIL_STORY", value: 63, script: "MangaSquare_Bibliotheque_Sc01"),
    Coord(x: 15, y: 7, var: "VAR_SIL_STORY", value: 63, script: "MangaSquare_Bibliotheque_Sc01"),
    // The four lore books (read from below): HISTOIRE, GEOGRAPHIE, LEGENDES, POKEMON.
    Sign(x: 3, y: 8, script: "MangaSquare_Bibliotheque_EventScript_Livre1"),
    Sign(x: 9, y: 8, script: "MangaSquare_Bibliotheque_EventScript_Livre2"),
    Sign(x: 3, y: 12, script: "MangaSquare_Bibliotheque_EventScript_Livre3"),
    Sign(x: 9, y: 12, script: "MangaSquare_Bibliotheque_EventScript_Livre4"),
    // The consultation terminals between the shelves.
    Sign(x: 6, y: 9, script: "MangaSquare_Bibliotheque_EventScript_Borne"),
    Sign(x: 12, y: 9, script: "MangaSquare_Bibliotheque_EventScript_Borne"),
    Sign(x: 6, y: 13, script: "MangaSquare_Bibliotheque_EventScript_Borne"),
    Sign(x: 12, y: 13, script: "MangaSquare_Bibliotheque_EventScript_Borne"),
    // Bibliotheque_Sc02: behind the west and east parchment racks (x 1-2 and 23-24, y 19).
    HiddenItem(x: 1, y: 18, item: "ITEM_MOON_STONE", flag: "FLAG_SIL_ITEM_BIBLIO_MOON_STONE"),
    HiddenItem(x: 24, y: 18, item: "ITEM_SUN_STONE", flag: "FLAG_SIL_ITEM_BIBLIO_SUN_STONE"),
]

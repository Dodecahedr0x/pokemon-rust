// The hidden items wave: the hidden items are Gen3's own again (BgKind::HiddenItem: A in front
// of one runs the game's EventScript_HiddenItemScript, silice::scripts::field), no longer signs
// running the `hidden_item` fallback.
[
    Replace(index: 8, event: Bg((x: 1, y: 18, elevation: 0, kind: HiddenItem(item: "ITEM_MOON_STONE", flag: "FLAG_SIL_ITEM_BIBLIO_MOON_STONE")))),
    Replace(index: 9, event: Bg((x: 24, y: 18, elevation: 0, kind: HiddenItem(item: "ITEM_SUN_STONE", flag: "FLAG_SIL_ITEM_BIBLIO_SUN_STONE")))),
]

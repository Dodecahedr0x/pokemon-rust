// The hidden items wave: the hidden items are Gen3's own again (BgKind::HiddenItem: A in front
// of one runs the game's EventScript_HiddenItemScript, silice::scripts::field), no longer signs
// running the `hidden_item` fallback.
[
    Replace(index: 3, event: Bg((x: 32, y: 71, elevation: 0, kind: HiddenItem(item: "ITEM_BIG_PEARL", flag: "FLAG_SIL_ITEM_S09_UW_1")))),
    Replace(index: 4, event: Bg((x: 19, y: 10, elevation: 0, kind: HiddenItem(item: "ITEM_STAR_PIECE", flag: "FLAG_SIL_ITEM_S09_UW_2")))),
    Replace(index: 5, event: Bg((x: 26, y: 15, elevation: 0, kind: HiddenItem(item: "ITEM_HEART_SCALE", flag: "FLAG_SIL_ITEM_S09_UW_3")))),
]

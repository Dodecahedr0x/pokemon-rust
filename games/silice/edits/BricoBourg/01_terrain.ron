// Cells: ground plan, then the buildings stamped over it.
[
    // Ground plan: T t Y y forest (2x2 pattern), . grass, * flowers, = gravel, { } [ ] ( ) canal (top, banks, end),
    // r R roots, b synthetic brambles, s signpost.
    Ascii(x: 0, y: 0, rows: [
        "TtTtTtTtTt.==.TtTtTtTtTt",
        "YyYyYyYyYy.==.YyYyYyYyYy",
        "Tt.......r.==.r....{}tTt",
        "Yy.......R.==.R....[]yYy",
        "Tt.......*.==......[]tTt",
        "Yy........s==..**..[]yYy",
        "Tt.........==......[]tTt",
        "Yy*........==......[]yYy",
        "Tt..b.s.=====......[]tTt",
        "Yy......=====......[]yYy",
        "Tt......=====......[]tTt",
        "Yy**....=====......[]yYy",
        "Tt......=..........[]tTt",
        "Yy......=...s.....*[]yYy",
        "Tt......=======....[]tTt",
        "Yy.................[]yYy",
        "Tt*................[]tTt",
        "Yy.................()yYy",
        "TtTtTtTtTtTtTtTtTtTtTtTt",
        "YyYyYyYyYyYyYyYyYyYyYyYy",
    ], legend: {'.': (metatile: 1, collision: 0), '*': (metatile: 4, collision: 0), '=': (metatile: 523, collision: 0), '{': (metatile: 200, collision: 1), '}': (metatile: 202, collision: 1), '[': (metatile: 208, collision: 1), ']': (metatile: 210, collision: 1), '(': (metatile: 216, collision: 1), ')': (metatile: 218, collision: 1), 'r': (metatile: 14, collision: 1), 'R': (metatile: 22, collision: 1), 'b': (metatile: 514, collision: 1), 's': (metatile: 27, collision: 1), 'T': (metatile: 468, collision: 1), 't': (metatile: 469, collision: 1), 'Y': (metatile: 476, collision: 1), 'y': (metatile: 477, collision: 1)}),
    // LABO (closed botany lab), x 3-6, y 2-7; its door (4, 7) is behind the brambles.

// Cells: ground plan, then the buildings stamped over it.
[
    // Ground plan: T t Y y forest (2x2 pattern), . grass, * flowers, = gravel, { } [ ] ( ) canal (SilBricoBourg's canal_haut, canal, canal_bas),
    // b synthetic brambles, f fence, s signpost.
    // The Labo door's front cell (4, 8) is a porch fenced at (3, 8) and (5, 8) and closed by the
    // brambles (4, 9): the cell the door's exit walk lands on stays walkable (SIL2 Ch1 scripts fix;
    // the brambles were on (4, 8), solid in the layout).
    Ascii(x: 0, y: 0, rows: [
        "TtTtTtTtTt.==.TtTtTtTtTt",
        "YyYyYyYyYy.==.YyYyYyYyYy",
        "Tt.........==......{}tTt",
        "Yy.........==......[]yYy",
        "Tt.......*.==......[]tTt",
        "Yy........s==..**..[]yYy",
        "Tt.........==......[]tTt",
        "Yy*........==......[]yYy",
        "Tt.f.fs.=====......[]tTt",
        "Yy..b...=====......[]yYy",
        "Tt......=====......[]tTt",
        "Yy**....=====......[]yYy",
        "Tt......=..........[]tTt",
        "Yy......=...s.....*[]yYy",
        "Tt......=======....[]tTt",
        "Yy.................[]yYy",
        "Tt*................[]tTt",
        "Yy.................()yYy",
        "TtTtTtTtTtTtTtTtTtTtTtTt",
        "YyYyYyYyYyYyYyYyYyYyYyYy",
    ], legend: {'.': (metatile: 1, collision: 0), '*': (metatile: 4, collision: 0), '=': (metatile: 603, collision: 0), '{': (metatile: 607, collision: 1), '}': (metatile: 608, collision: 1), '[': (metatile: 605, collision: 1), ']': (metatile: 606, collision: 1), '(': (metatile: 609, collision: 1), ')': (metatile: 610, collision: 1), 'b': (metatile: 604, collision: 1), 'f': (metatile: 6, collision: 1), 's': (metatile: 27, collision: 1), 'T': (metatile: 468, collision: 1), 't': (metatile: 469, collision: 1), 'Y': (metatile: 476, collision: 1), 'y': (metatile: 477, collision: 1)}),
    // The buildings and props: SilBricoBourg's stamps (games/silice/gfx/SilBricoBourg.ron, original art).
    // LABO (closed botany lab), x 2-6, y 2-7; its door (4, 7) is behind the brambles.
    // The door is solid until Chapter 1 gives it a warp: a closed, decorative door.
    Stamp(x: 2, y: 2, name: "SilBricoBourg_labo"),
    // Adrien's family house, x 15-17, y 3-6, door (16, 6), solid as in Emerald (pushing up into it warps).
    Stamp(x: 15, y: 3, name: "SilBricoBourg_maison_adrien"),
    // Fountain, x 9-10, y 9-10.
    Stamp(x: 9, y: 9, name: "SilBricoBourg_fontaine"),
    // LE SHAKER, x 13-15, y 9-13, door (14, 13).
    Stamp(x: 13, y: 9, name: "SilBricoBourg_shaker"),
    // Noobody's house, x 4-6, y 11-14, door (5, 14).
    Stamp(x: 4, y: 11, name: "SilBricoBourg_maison_joueur"),
    // The tinkerer's open workshop, x 7-9, y 4-5 (the BRICOLEUSE stands in front, at (7, 6)).
    Stamp(x: 7, y: 4, name: "SilBricoBourg_atelier"),
    // The giant roots flanking the north exit, x 8-9 and 14-15, y 0-2 (in place of the forest's edge trees).
    Stamp(x: 8, y: 0, name: "SilBricoBourg_racines_g"),
    Stamp(x: 14, y: 0, name: "SilBricoBourg_racines_d"),
    // Dismantled bikes in front of the doors.
    Stamp(x: 7, y: 14, name: "SilBricoBourg_velo"),
    Stamp(x: 17, y: 7, name: "SilBricoBourg_velo"),
    // Vegetable garden, x 8-10, y 15-17 (walkable between the rows).
    Stamp(x: 8, y: 15, name: "SilBricoBourg_potager"),
]

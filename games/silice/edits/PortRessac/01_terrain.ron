        'O': (metatile: 444, collision: 1),
        // SilPortRessac: dune grass (tall grass), crate, rum barrel, the quay's wooden edge, the piers' planks.
        'g': (metatile: 656, collision: 0),
        'k': (metatile: 608, collision: 1),
        'u': (metatile: 609, collision: 1),
        'q': (metatile: 657, collision: 1),
        'p': (metatile: 658, collision: 0),

        "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",
    ], legend: {
        '^': (metatile: 113, collision: 1),
        'n': (metatile: 124, collision: 1),
        'f': (metatile: 169, collision: 1),
        'v': (metatile: 159, collision: 1),
        'b': (metatile: 145, collision: 1),
        'D': (metatile: 167, collision: 0),

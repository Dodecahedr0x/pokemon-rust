        "rgggg.....................................bbbbbber",
        "rgggg...........................................er",
        "rgggg....gggggggg...................uk..........er",
        "r.....k..gggggggg.......ku......................er",
        "r..kuk.k.gggggggg...............................er",
        "r..u...u.gggggggg.....................k.........er",
        "r..kuk.k........................................er",
        "r................................uk.kuku........er",
        "r...............................................er",
        "r...............................................er",
        "r.........................s.....................er",
        "qqppqqqqqqqqqqqqqqqqqqqqqqqppqqqqqqqqqqqJKKKKKKL__",
        "__pp}}}}}}}}_______________pp}}}}}}}}___JKKKKKKL__",
        "~~pp}}}}}}}}~~~~~~~~~~~~~~~pp}}}}}}}}~~~JKKKKKKL~~",
        "~~pp}}}}}}}}~~~~~~~~~~~~~~~pp}}}}}}}}~~~MNNNNNNO~~",
        "~~pp}}}}}}}}~~~~~~~~~~~~~~~pp}}}}}}}}~~~________~~",
        "~~ppppppp}}}~~~~~~~~~~~~~~~ppppppp}}}~~~~~~~~~~~~~",
        "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",

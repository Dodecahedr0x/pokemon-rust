    Stamp(x: 19, y: 11, name: "SilPortRessac_cont_bleu"),
    Stamp(x: 27, y: 14, name: "SilPortRessac_cont_rouge"),
    // The west containers over the corridor (x 1-14, y 18-19), the alcoves at x 7, 9, 11, 13 (y 19).
    Stamp(x: 1, y: 18, name: "SilPortRessac_cont_vert"),
    Stamp(x: 3, y: 18, name: "SilPortRessac_cont_bleu"),

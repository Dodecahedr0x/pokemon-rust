// Cells, then SilOwlys's stamps (games/silice/gfx/SilOwlys.ron, original art). The first build's
// collisions and elevations stay cell for cell.
[
    // Ground plan. . the flagstones (MB_CAVE), v the void (blocked), { = } ( + ) the hanging iron
    // walkways (two rows: the top rail, the bottom rail), # the cavern rock, ^ 7 9 l r the carved wall
    // faces, P a wall face with a yellow steam projector, [ ] _ J L the rock rims, K a Hoothoot
    // gargoyle perched on the Ruelle des Gargouilles' rim, o gargoyles on pedestals. A B C D E F G H h x
    // are under the stamps below (the first build's cave holes and iron door; h the doors, x the arrows).
    Ascii(x: 0, y: 0, rows: [
        "############################################################",
        "############################################################",
        "#############################ABC############################",
        "##7^^^^^9#######7^^^P^^^^P^^^DhE^^^P^^^^P^^9#######7^^^^^9##",
        "##[.....]#######[..........................]#######[.....]##",
        "##[.....]#######[..........................]#######[.....]##",
        "##[.....]#######[..........................]#######[.....]##",
        "##[.....]##ABC##[........J_________L.......]##ABC##[.....]##",
        "##[.....l^^DhE^^r........]#########[.......l^^DhE^^r.....]##",
        "##[......................]#########[.....................]##",
        "##[......................]#########[.....................]##",
        "##[......................]###ABC###[.....................]##",
        "##[......................l^^^DhE^^^r.....................]##",
        "##[......................................................]##",
        "##7^^P^r............................................l^P^^9##",
        "##[.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##[.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##K.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##[.....{==================}....{==================}.....]##",
        "##[.....(++++++++++++++++++)....(++++++++++++++++++).....]##",
        "##[.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##K.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##[.....vvvvvvvvvvvvvvvvvvvv....vvvvvvvvvvvvvvvvvvvv.....]##",
        "##[.....JL..........................................J_____##",
        "##[.....][..........................................]#######",
        "##K.....][..........................................]#######",
        "##[.....][........................o.................]#######",
        "##[.....][...................oo.....................]ABC####",
        "##[.....][...................oo.....................lDhE9###",
        "##K.....][..............................................]###",
        "##[.....][..............................................]###",
        "##[.....][..............................................]###",
        "##[.....][.............................J_________________###",
        "##K.....][.............................]####################",
        "##[.....][............J____L....J_______####################",
        "##_______[............]####[....]###########################",
        "#########[............]####[....]###########################",
        "#########[............]####[....]###########################",
        "#########[...ABC......]####[....]###########################",
        "#########[...DhE......]####[....]###########################",
        "#########[............]####[....]###########################",
        "#########______________####[....]###########################",
        "###########################[....]###########################",
        "##########################7P....P9##########################",
        "##########################[o....o]##########################",
        "##########################_L.xx.J_##########################",
        "###########################_FGGH_###########################",
        "############################################################",
        "############################################################",
        "############################################################",
    ], legend: {
        '.': (metatile: 512, collision: 0, elevation: 3),
        '{': (metatile: 513, collision: 0, elevation: 3),
        '=': (metatile: 513, collision: 0, elevation: 3),
        '}': (metatile: 513, collision: 0, elevation: 3),
        '(': (metatile: 514, collision: 0, elevation: 3),
        '+': (metatile: 514, collision: 0, elevation: 3),
        ')': (metatile: 514, collision: 0, elevation: 3),
        'v': (metatile: 515, collision: 1, elevation: 0),
        '#': (metatile: 516, collision: 1, elevation: 0),
        '7': (metatile: 517, collision: 1, elevation: 0),
        '9': (metatile: 517, collision: 1, elevation: 0),
        '^': (metatile: 517, collision: 1, elevation: 0),
        'l': (metatile: 517, collision: 1, elevation: 0),
        'r': (metatile: 517, collision: 1, elevation: 0),
        '[': (metatile: 518, collision: 1, elevation: 0),
        ']': (metatile: 519, collision: 1, elevation: 0),
        '_': (metatile: 520, collision: 1, elevation: 0),
        'J': (metatile: 520, collision: 1, elevation: 0),
        'L': (metatile: 520, collision: 1, elevation: 0),
        'o': (metatile: 651, collision: 1, elevation: 3),
        'P': (metatile: 652, collision: 1, elevation: 0),
        'K': (metatile: 653, collision: 1, elevation: 0),
        'A': (metatile: 516, collision: 1, elevation: 0),
        'B': (metatile: 516, collision: 1, elevation: 0),
        'C': (metatile: 516, collision: 1, elevation: 0),
        'D': (metatile: 516, collision: 1, elevation: 0),
        'E': (metatile: 516, collision: 1, elevation: 0),
        'F': (metatile: 516, collision: 1, elevation: 0),
        'G': (metatile: 516, collision: 1, elevation: 0),
        'H': (metatile: 516, collision: 1, elevation: 0),
        'h': (metatile: 512, collision: 0, elevation: 3),
        'x': (metatile: 654, collision: 0, elevation: 3),
    }),
    // The Pilgrims' Elevator, x 29-31, y 0-3, door (30, 3).
    Stamp(x: 29, y: 0, name: "SilOwlys_ascenseur"),
    // The orphanage, x 10-14, y 5-8, door (12, 8); the Plume-Noire warehouse (red neons), x 45-49,
    // y 5-8, door (47, 8).
    Stamp(x: 10, y: 5, name: "SilOwlys_orphelinat"),
    Stamp(x: 45, y: 5, name: "SilOwlys_entrepot"),
    // The Owl Sanctuary, x 27-33, y 7-12, door (30, 12): its spires stand over the north square.
    Stamp(x: 27, y: 7, name: "SilOwlys_sanctuaire"),
    // The Centre, x 14-17, y 26-29, door (15, 29), a projector lamp on its right.
    Stamp(x: 14, y: 26, name: "SilOwlys_centre"),
    // The dry fountain of the Place des Gargouilles, x 29-30, y 27-28.
    Stamp(x: 29, y: 27, name: "SilOwlys_fontaine"),
    // The convoy tunnel to the East Cave, x 53-55, y 27-28, door (54, 28).
    Stamp(x: 53, y: 27, name: "SilOwlys_tunnel"),
    // The Gray Market, x 13-15, y 38-39, door (14, 39).
    Stamp(x: 13, y: 38, name: "SilOwlys_marche"),
    // The iron gate from the Sea Rift, x 28-31, y 46, under the arrows (29, 45) and (30, 45).
    Stamp(x: 28, y: 46, name: "SilOwlys_porte"),
    // The sanctuary's door is locked (solid) until Owlys_Sc04 sets FLAG_SIL_OWLYS_PORTE_GYM; Owlys_OnLoad
    // then sets its collision to 0 (METATILE_PORTE_GYM, ch05_owlys.rs).
    Paint(x: 30, y: 12, collision: 1),
]

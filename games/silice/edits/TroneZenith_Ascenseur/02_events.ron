// Header, map scripts, warps, objects.
[
    // Music: the ascent's MUS_SIL_ELYSIUM (a new song); placeholder MUS_SEALED_CHAMBER, the source's
    // fallback. The descent's MUS_SIL_VRAI_CIEL (fallback MUS_END) is played by Ascenseur_Sc12.
    Header((music: "MUS_SEALED_CHAMBER", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // The cabin's "load scripts": TroneZenith_Ascenseur_Sc00, an on-frame script on VAR_TEMP_1 0 (never
    // written here, so it runs on every arrival), dispatches on VAR_SIL_STORY: 114 or 115 (the retry after
    // a lost Cocorico fight, Trone_Zenith_Sc08_Lose's fallback) plays the ascent's second half
    // (TroneZenith_Ascenseur_Sc07: sets 115, warps to TroneZenith (7, 13)); 117 plays the descent
    // (TroneZenith_Ascenseur_Sc12: sets 118, warps to Nebula's tower exit, Ch9). Both always warp away.
    // TroneZenith_Ascenseur_OnTransition shows the four friends at 117 only (FLAG_SIL_HIDE_ZENITH_ASC_*).
    ScriptsSet(on_transition: "TroneZenith_Ascenseur_OnTransition", on_frame: [(var: "VAR_TEMP_1", value: 0, script: "TroneZenith_Ascenseur_Sc00")]),
    // Landings (golden floor: they never warp, see 03_allow). Warp 0: the source's arrival (3, 4), from
    // the Apex's crystal tube. Warps 1-2: the Zenith's tube landing (the day map, and its night variant).
    Warp(x: 3, y: 4, dest_map: "SommetApex", dest_warp: 1),
    Warp(x: 3, y: 5, dest_map: "TroneZenith", dest_warp: 0),
    Warp(x: 3, y: 6, dest_map: "TroneZenith_Nuit", dest_warp: 0),
    // Objects 1-4 (the source's): Mathieu, Adrien, Gwada, Julien, around the player during the descent.
    Object(x: 2, y: 3, gfx: "OBJ_EVENT_GFX_SIL_MATHIEU", id: "LOCALID_ZENITH_ASC_MATHIEU", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_ZENITH_ASC_MATHIEU"),
    Object(x: 4, y: 3, gfx: "OBJ_EVENT_GFX_SIL_ADRIEN", id: "LOCALID_ZENITH_ASC_ADRIEN", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_ZENITH_ASC_ADRIEN"),
    Object(x: 2, y: 5, gfx: "OBJ_EVENT_GFX_SIL_GWADA", id: "LOCALID_ZENITH_ASC_GWADA", local_id: 3, movement: "MOVEMENT_TYPE_FACE_UP", flag: "FLAG_SIL_HIDE_ZENITH_ASC_GWADA"),
    Object(x: 4, y: 5, gfx: "OBJ_EVENT_GFX_SIL_JULIEN", id: "LOCALID_ZENITH_ASC_JULIEN", local_id: 4, movement: "MOVEMENT_TYPE_FACE_UP", flag: "FLAG_SIL_HIDE_ZENITH_ASC_JULIEN"),
]

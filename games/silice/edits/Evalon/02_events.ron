// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_FALLARBOR", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_TOWN", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnLoad: draws the drawbridge down (x 24-26, y 7-8) from VAR_SIL_STORY 83, the flowing fountain
    // (18-20, 39-41) once FLAG_SIL_EVALON_Q1_ROCHER, and the cut brambles (44, 26-29) after Q3's cut.
    // OnTransition: the hide flags below from VAR_SIL_STORY, and the guards stepping aside
    // (setobjectxyperm) from 83.
    Scripts((on_load: Some("Evalon_OnLoad"), on_transition: Some("Evalon_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warps: 0 Taverne, 1 Echoppe, 2 Forge, 3 Tour du Scribe, 4 Galeries, 5 Maison des Anciens,
    // 6 Citadelle, on the source's cells.
    Warp(x: 22, y: 26, dest_map: "Evalon_Taverne", dest_warp: 0),
    Warp(x: 28, y: 26, dest_map: "Evalon_Echoppe", dest_warp: 0),
    Warp(x: 32, y: 30, dest_map: "Evalon_Forge", dest_warp: 0),
    Warp(x: 6, y: 20, dest_map: "Evalon_TourScribe", dest_warp: 0),
    Warp(x: 3, y: 12, dest_map: "Evalon_Galeries", dest_warp: 0),
    Warp(x: 42, y: 22, dest_map: "Evalon_Conseil", dest_warp: 0),
    Warp(x: 25, y: 3, dest_map: "Evalon_Citadelle", dest_warp: 0),
    // Sc01's friends (shown at story 80-81 north of the square, and at 83 below the gate,
    // setobjectxyperm (24-26, 16)); hidden otherwise. Mathieu keeps the source's FLAG_SIL_HIDE_EVALON_AMIS.
    Object(x: 24, y: 41, gfx: "OBJ_EVENT_GFX_BLACK_BELT", id: "LOCALID_EVALON_MATHIEU", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_AMIS"),
    Object(x: 23, y: 40, gfx: "OBJ_EVENT_GFX_SCHOOL_KID_M", id: "LOCALID_EVALON_ADRIEN", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_ADRIEN"),
    Object(x: 26, y: 40, gfx: "OBJ_EVENT_GFX_BOY_2", id: "LOCALID_EVALON_GWADA", local_id: 3, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_GWADA"),
    // The Scribe comes to Sc01 (shown at 80-81 only), then goes back to his tower.
    Object(x: 17, y: 44, gfx: "OBJ_EVENT_GFX_OLD_MAN", id: "LOCALID_EVALON_SCRIBE", local_id: 4, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_SCRIBE"),
    // The Porte du Fer: Bertrand and Iolanda flank the gate, Perceval stands in it (Sc04 when
    // talked to; all three run Sc04). From 83 OnTransition moves them aside: (22, 12), (27, 12), (28, 10).
    Object(x: 23, y: 14, gfx: "OBJ_EVENT_GFX_BLACK_BELT", id: "LOCALID_EVALON_BERTRAND", local_id: 6, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_Sc04"),
    Object(x: 27, y: 14, gfx: "OBJ_EVENT_GFX_EXPERT_F", id: "LOCALID_EVALON_IOLANDA", local_id: 7, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_Sc04"),
    Object(x: 25, y: 13, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_EVALON_PERCEVAL", local_id: 8, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_Sc04"),
    // Sc07's invaders, out of the Galeries side of the yard (hidden outside the scene).
    Object(x: 12, y: 10, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_EVALON_GOGO", local_id: 10, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_GOGO_ROMAIN"),
    Object(x: 12, y: 11, gfx: "OBJ_EVENT_GFX_AQUA_MEMBER_M", id: "LOCALID_EVALON_ROMAIN", local_id: 11, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_ROMAIN"),
    Object(x: 11, y: 9, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_EVALON_SBIRE_1", local_id: 12, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_SBIRE_1"),
    Object(x: 11, y: 10, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_F", id: "LOCALID_EVALON_SBIRE_2", local_id: 13, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_SBIRE_2"),
    Object(x: 11, y: 11, gfx: "OBJ_EVENT_GFX_MAGMA_MEMBER_M", id: "LOCALID_EVALON_SBIRE_3", local_id: 14, movement: "MOVEMENT_TYPE_FACE_DOWN", flag: "FLAG_SIL_HIDE_EVALON_SBIRE_3"),
    // Ambient NPCs (Npc_1 to Npc_8; the child says Npc_1b from story 84).
    Object(x: 15, y: 34, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_EVALON_ENFANT", local_id: 15, movement: "MOVEMENT_TYPE_WANDER_AROUND", range_x: 1, range_y: 1, script: "Evalon_EventScript_Enfant"),
    Object(x: 13, y: 33, gfx: "OBJ_EVENT_GFX_WOMAN_2", id: "LOCALID_EVALON_MERE", local_id: 16, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_EventScript_Mere"),
    Object(x: 26, y: 29, gfx: "OBJ_EVENT_GFX_YOUNGSTER", id: "LOCALID_EVALON_ROLISTE", local_id: 17, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Evalon_EventScript_Roliste"),
    Object(x: 43, y: 41, gfx: "OBJ_EVENT_GFX_HIKER", id: "LOCALID_EVALON_CHAUDRONNIER", local_id: 18, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Evalon_EventScript_Chaudronnier"),
    Object(x: 11, y: 36, gfx: "OBJ_EVENT_GFX_OLD_WOMAN", id: "LOCALID_EVALON_VIEILLE_DAME", local_id: 19, movement: "MOVEMENT_TYPE_FACE_UP", script: "Evalon_EventScript_VieilleDame"),
    // The pigeon-keeper's apprentice outside the Pigeonnier (the keeper himself, the PC and Q3, is in the
    // Taverne's Pigeonnier room).
    Object(x: 16, y: 28, gfx: "OBJ_EVENT_GFX_BOY_1", id: "LOCALID_EVALON_APPRENTI_COLOMBOPHILE", local_id: 20, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_EventScript_ApprentiColombophile"),
    Object(x: 33, y: 15, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_EVALON_GARDE_BEFFROI", local_id: 21, movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Evalon_EventScript_GardeBeffroi"),
    Object(x: 40, y: 33, gfx: "OBJ_EVENT_GFX_MANIAC", id: "LOCALID_EVALON_MJ", local_id: 22, movement: "MOVEMENT_TYPE_FACE_UP", script: "Evalon_EventScript_Mj"),
    // Q1: the fairy by the dry fountain.
    Object(x: 17, y: 42, gfx: "OBJ_EVENT_GFX_LITTLE_GIRL", id: "LOCALID_EVALON_FEE", local_id: 23, movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Evalon_EventScript_Fee"),
    // Q3: Plume-d'Argent behind the brambles (44, 26-29); hidden once he has flown home.
    Object(x: 46, y: 27, gfx: "OBJ_EVENT_GFX_WINGULL", id: "LOCALID_EVALON_PIGEON", local_id: 24, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_EventScript_Pigeon", flag: "FLAG_SIL_HIDE_EVALON_PIGEON"),
    // The south-east shepherd's path to Route S9 (closed here: see the pending links); its guard
    // until VAR_SIL_STORY 85.
    Object(x: 44, y: 45, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_EVALON_GARDE_SE", local_id: 25, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_EventScript_GardeSE", flag: "FLAG_SIL_HIDE_EVALON_GARDE_SE"),
    // The PP Up on the mill pond's islet (Hydro-Propulseur).
    Object(x: 37, y: 40, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_EVALON_ITEM_PP_UP", local_id: 26, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Evalon_EventScript_ItemPpUp", flag: "FLAG_SIL_ITEM_EVALON_ETANG"),
    // Sc01: three cells inside the south portal, the whole corridor (x 23-26).
    Coord(x: 23, y: 45, var: "VAR_SIL_STORY", value: 81, script: "Evalon_Sc01"),
    Coord(x: 24, y: 45, var: "VAR_SIL_STORY", value: 81, script: "Evalon_Sc01"),
    Coord(x: 25, y: 45, var: "VAR_SIL_STORY", value: 81, script: "Evalon_Sc01"),
    Coord(x: 26, y: 45, var: "VAR_SIL_STORY", value: 81, script: "Evalon_Sc01"),
    // Sc07: the yard's whole row y 10 (x 11-38), between the Porte du Fer and the drawbridge,
    // so the bridge cannot be reached without it.
    Coord(x: 11, y: 10, var: "VAR_SIL_STORY", value: 83, script: "Evalon_Sc07"),
    Coord(x: 12, y: 10, var: "VAR_SIL_STORY", value: 83, script: "Evalon_Sc07"),

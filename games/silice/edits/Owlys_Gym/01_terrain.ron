// Cells, then SilOwlysGym's stamps (games/silice/gfx/SilOwlysGym.ron, original art). The first
// build's collisions and elevations stay cell for cell.
[
    // Ground plan. v the void (blocked), . the slabs (MB_CAVE), = bridge planks (p1, posed at start),
    // t trapdoors (cracked slabs, warps to B1F), R B N the lecterns (red, blue and black books), # the
    // masonry, ^ 7 9 the wall with its red stained glass, [ ] _ the wall rims. J L l r (the pillars), x
    // (the exit's arrow) and F G H are under the stamps below. The raised bridges p2-p5 and the
    // platform's walkway are void here; the scripts draw them (ch05_gym.rs POSE / RELEVE).
    Ascii(x: 0, y: 0, rows: [
        "7^^^^^^^^^^^^^^^^^^^^^^^^^^^^9",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv.....................vvvv]",
        "[vvv.....................vvvv]",
        "[vvv...JL...........JL...vvvv]",
        "[vvv...lr...........lr...vvvv]",
        "[vvv.....t........t......vvvv]",
        "[vvv.....................vvvv]",
        "[vvv...JL...........JL...vvvv]",
        "[vvv...lr...........lr...vvvv]",
        "[vvv.....................vvvv]",
        "[vvv.....................vvvv]",
        "[vvvvvvvvvvv.....vvvvvvvvvvvv]",
        "[vvvvvvvvvvv.....vvvvvvvvvvvv]",
        "[vvvvvvvvvvv.....vvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvvvvvvvvvvvvvvvvvvvvvvvvvvv]",
        "[v.....vvvvv.....vvvvv.t...vv]",
        "[v.B...vvvvv.....vvvvv..N..vv]",
        "[v.....vvvvv.....vvvvv.....vv]",
        "[v.....vvvvv.....vvvvv.....vv]",
        "[v.....vvvvv..t..vvvvv.....vv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvvvvvvvvvvvvvvvvvvvv]",
        "[vvv=vvvvvv.......vvvvvvvvvvv]",
        "[vvv=vvvvvv.....R.vvvvvvvvvvv]",
        "[vvv=======.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "[vvvvvvvvvv.......vvvvvvvvvvv]",
        "_____________LxJ______________",
        "#############FGH##############",
        "##############################",
    ], legend: {
        '.': (metatile: 512, collision: 0, elevation: 3),
        'v': (metatile: 541, collision: 1, elevation: 0),
        '=': (metatile: 542, collision: 0, elevation: 3),
        't': (metatile: 543, collision: 0, elevation: 3),
        '#': (metatile: 544, collision: 1, elevation: 0),
        '7': (metatile: 545, collision: 1, elevation: 0),
        '9': (metatile: 545, collision: 1, elevation: 0),
        '^': (metatile: 545, collision: 1, elevation: 0),
        '[': (metatile: 546, collision: 1, elevation: 0),
        ']': (metatile: 547, collision: 1, elevation: 0),
        '_': (metatile: 548, collision: 1, elevation: 0),
        'J': (metatile: 548, collision: 1, elevation: 0),
        'L': (metatile: 548, collision: 1, elevation: 0),
        'l': (metatile: 548, collision: 1, elevation: 0),
        'r': (metatile: 548, collision: 1, elevation: 0),
        'R': (metatile: 555, collision: 1, elevation: 3),
        'B': (metatile: 556, collision: 1, elevation: 3),
        'N': (metatile: 557, collision: 1, elevation: 3),
        'x': (metatile: 512, collision: 0, elevation: 3),
        'F': (metatile: 544, collision: 1, elevation: 0),
        'G': (metatile: 544, collision: 1, elevation: 0),
        'H': (metatile: 544, collision: 1, elevation: 0),
    }),
    // Skycker's suspended platform, x 11-17, y 2-5 (the owl emblem in its middle).
    Stamp(x: 11, y: 2, name: "SilOwlysGym_plateforme"),
    // The Hall of Pillars: the four hollow pillars, owls with red eyes on top (2x2 each), Watchers 1-4
    // beside them. Their top rows (y 14 and 18) are what ch05_gym.rs repaints with pilier_eteint.
    Stamp(x: 7, y: 14, name: "SilOwlysGym_pilier"),
    Stamp(x: 20, y: 14, name: "SilOwlysGym_pilier"),
    Stamp(x: 7, y: 18, name: "SilOwlysGym_pilier"),
    Stamp(x: 20, y: 18, name: "SilOwlysGym_pilier"),
    // The exit, x 13-15, y 47-48, arrow (14, 47).
    Stamp(x: 13, y: 47, name: "SilOwlysGym_sortie"),
]

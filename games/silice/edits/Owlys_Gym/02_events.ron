// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_GYM", region_map_section: "MAPSEC_NONE", cave: 1, weather: "WEATHER_NONE", map_type: "MAP_TYPE_UNDERGROUND", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // cave: 1 makes it dark until Flash; the engine does not draw darkness yet. The trapdoors should only
    // show under the light (missing mechanic); they are always drawn, as the source's fallback says.
    // Bridge cells (for the scripts' set_metatile: posed = 700 walkable, raised = 581 solid):
    //   p1: (4,34) (4,35) (4,36) (4,37) (4,38) (4,39) (4,40) (4,41) (4,42) (4,43) (5,43) (6,43) (7,43) (8,43) (9,43) (10,43)
    //   p2: (24,34) (24,35) (24,36) (24,37) (24,38) (24,39) (24,40) (24,41) (24,42) (24,43) (18,43) (19,43) (20,43) (21,43) (22,43) (23,43)
    //   p3: (7,31) (8,31) (9,31) (10,31) (11,31)
    //   p4: (17,31) (18,31) (19,31) (20,31) (21,31)
    //   p5: (14,25) (14,26) (14,27) (14,28)
    //   walk: (14,6) (14,7) (14,8) (14,9) (14,10) (14,11)
    // Map scripts: Owlys_Gym_OnLoad redraws the bridges (resets FLAG_SIL_OWLYS_GYM_P1-P5 to p1 posed unless
    // FLAG_SIL_OWLYS_GYM_COUR_OK, then all posed), the Watchers' statues and the walkway (posed once
    // FLAG_SIL_OWLYS_VEILLEUR_1-4 are all set). Owlys_Gym_OnTransition sets the hide flags.
    Scripts((on_load: Some("Owlys_Gym_OnLoad"), on_transition: Some("Owlys_Gym_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the exit, to Owlys's warp 7 (the crypt's ladder also leads here). Warps 1-4: the trapdoors,
    // to B1F's warp 1 (the landing).
    Warp(x: 14, y: 47, dest_map: "Owlys", dest_warp: 7),
    Warp(x: 23, y: 29, dest_map: "Owlys_Gym_B1F", dest_warp: 1),
    Warp(x: 14, y: 33, dest_map: "Owlys_Gym_B1F", dest_warp: 1),
    Warp(x: 9, y: 16, dest_map: "Owlys_Gym_B1F", dest_warp: 1),
    Warp(x: 18, y: 16, dest_map: "Owlys_Gym_B1F", dest_warp: 1),
    // Objects 1-3: Owlys_Gym_Sc01's actors (the source's numbers). 1: Skycker, masked. 2: Skycker, his face
    // shown (hidden, same cell). 3: Mathieu (hidden), on the walkway: he walks up four cells.
    Object(x: 14, y: 3, gfx: "OBJ_EVENT_GFX_SIDNEY", id: "LOCALID_GYM_SKYCKER_MASQUE", local_id: 1, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Owlys_Gym_Sc01", flag: "FLAG_SIL_HIDE_OWLYS_GYM_SKYCKER_MASQUE"),
    Object(x: 14, y: 3, gfx: "OBJ_EVENT_GFX_STEVEN", id: "LOCALID_GYM_SKYCKER_VISAGE", local_id: 2, movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Owlys_Gym_EventScript_Skycker", flag: "FLAG_SIL_HIDE_OWLYS_GYM_SKYCKER_VISAGE"),
    Object(x: 14, y: 9, gfx: "OBJ_EVENT_GFX_SIL_MATHIEU", id: "LOCALID_GYM_MATHIEU", local_id: 3, movement: "MOVEMENT_TYPE_FACE_UP", flag: "FLAG_SIL_HIDE_OWLYS_GYM_MATHIEU"),
    // 4-7: the four Watchers (sight 2), by their pillars (Ariane, Morgane, Corvus, Nyx). The source hides
    // them inside the pillars until the player crosses their line of sight (missing mechanic): they stand
    // beside them. Each one's script sets FLAG_SIL_OWLYS_VEILLEUR_n and puts out its statue's eyes.
    // 8: the gym guide. 9: the Sharp Beak on islet E's perch.
    Object(x: 9, y: 14, gfx: "OBJ_EVENT_GFX_EXPERT_F", id: "LOCALID_GYM_VEILLEUR_1", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Owlys_Gym_EventScript_Ariane", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 19, y: 14, gfx: "OBJ_EVENT_GFX_HEX_MANIAC", id: "LOCALID_GYM_VEILLEUR_2", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Owlys_Gym_EventScript_Morgane", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 9, y: 19, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_GYM_VEILLEUR_3", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Owlys_Gym_EventScript_Corvus", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 19, y: 19, gfx: "OBJ_EVENT_GFX_PSYCHIC_M", id: "LOCALID_GYM_VEILLEUR_4", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "Owlys_Gym_EventScript_Nyx", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 12, y: 45, gfx: "OBJ_EVENT_GFX_MAN_2", id: "LOCALID_GYM_GUIDE", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "Owlys_Gym_EventScript_Guide"),
    Object(x: 26, y: 33, gfx: "OBJ_EVENT_GFX_ITEM_BALL", id: "LOCALID_GYM_ITEM_SHARP_BEAK", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "Owlys_Gym_EventScript_ItemBecPointu", flag: "FLAG_SIL_ITEM_OWLYS_GYM_BEC_POINTU"),
    // Owlys_Gym_EventScript_CourOk: reaching islet N (its row y 24) sets FLAG_SIL_OWLYS_GYM_COUR_OK (on
    // VAR_TEMP_1 0; the script sets VAR_TEMP_1 to 1).
    Coord(x: 12, y: 24, var: "VAR_TEMP_1", value: 0, script: "Owlys_Gym_EventScript_CourOk"),
    Coord(x: 13, y: 24, var: "VAR_TEMP_1", value: 0, script: "Owlys_Gym_EventScript_CourOk"),
    Coord(x: 14, y: 24, var: "VAR_TEMP_1", value: 0, script: "Owlys_Gym_EventScript_CourOk"),
    Coord(x: 15, y: 24, var: "VAR_TEMP_1", value: 0, script: "Owlys_Gym_EventScript_CourOk"),
    Coord(x: 16, y: 24, var: "VAR_TEMP_1", value: 0, script: "Owlys_Gym_EventScript_CourOk"),
    // The three lecterns: the red book (S), the blue book (O), the black book (E). Each toggles its bridges.
    Sign(x: 16, y: 42, script: "Owlys_Gym_EventScript_LivreRouge"),
    Sign(x: 3, y: 30, script: "Owlys_Gym_EventScript_LivreBleu"),
    Sign(x: 24, y: 30, script: "Owlys_Gym_EventScript_LivreNoir"),
]

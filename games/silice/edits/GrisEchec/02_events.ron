// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_RUSTBORO", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_CITY", allow_cycling: true, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // OnTransition: the music (white noise while VAR_SIL_STORY is 23), the arena guard's cell
    // ((35, 10) once VAR_SIL_STORY >= 25), and the hide flags below. OnLoad: the Tour door (21-22, 4)
    // drawn shut until FLAG_SIL_TOUR_OPEN, the jammers drawn off per FLAG_SIL_GRIS_JAMMER_1/_2, and the
    // barrier (39, 1) open once VAR_SIL_STORY >= 28.
    Scripts((on_load: Some("GrisEchec_OnLoad"), on_transition: Some("GrisEchec_OnTransition"), on_resume: None, on_return_to_field: None, on_dive_warp: None, on_frame: [], on_warp_into: [])),
    // Warp 0: the Centre. 1: the Mart. 2-3: the Tour d'Observation. 4: the arena. 5: the factory.
    Warp(x: 5, y: 8, dest_map: "GrisEchec_PokemonCenter", dest_warp: 0),
    Warp(x: 11, y: 8, dest_map: "GrisEchec_Mart", dest_warp: 0),
    Warp(x: 21, y: 4, dest_map: "GrisEchec_TourObservation", dest_warp: 0),
    Warp(x: 22, y: 4, dest_map: "GrisEchec_TourObservation", dest_warp: 1),
    Warp(x: 34, y: 9, dest_map: "GrisEchec_Gym", dest_warp: 0),
    Warp(x: 30, y: 20, dest_map: "GrisEchec_Usine", dest_warp: 0),
    // Objects in the source's order (local ids 1-12 = its obj numbers). The townsfolk read
    // VAR_SIL_GRIS_ECHEC_STATE (white noise until their jammer is cut). Hide flags are temp flags
    // that GrisEchec_OnTransition sets: Gwada (8) outside VAR_SIL_STORY 24-27, the S3 guard (11) from
    // 28, Lainergie (12) outside 27.
    Object(x: 15, y: 13, gfx: "OBJ_EVENT_GFX_GENTLEMAN", id: "LOCALID_GRIS_ECHECS", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "GrisEchec_EventScript_Echecs"),
    Object(x: 9, y: 11, gfx: "OBJ_EVENT_GFX_WOMAN_3", id: "LOCALID_GRIS_PRESSEE", movement: "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT", range_x: 1, range_y: 0, script: "GrisEchec_EventScript_Pressee"),
    Object(x: 26, y: 8, gfx: "OBJ_EVENT_GFX_OLD_MAN", id: "LOCALID_GRIS_REPARATEUR", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "GrisEchec_EventScript_Reparateur"),
    Object(x: 18, y: 17, gfx: "OBJ_EVENT_GFX_GIRL_3", id: "LOCALID_GRIS_ETUDIANTE", movement: "MOVEMENT_TYPE_FACE_UP", script: "GrisEchec_EventScript_Etudiante"),
    Object(x: 28, y: 21, gfx: "OBJ_EVENT_GFX_MAN_4", id: "LOCALID_GRIS_OUVRIER", movement: "MOVEMENT_TYPE_FACE_UP", script: "GrisEchec_EventScript_Ouvrier"),
    Object(x: 6, y: 16, gfx: "OBJ_EVENT_GFX_LITTLE_BOY", id: "LOCALID_GRIS_ENFANT", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "GrisEchec_EventScript_Enfant"),
    Object(x: 34, y: 10, gfx: "OBJ_EVENT_GFX_EXPERT_M", id: "LOCALID_GRIS_GARDE", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "GrisEchec_Sc03"),
    Object(x: 33, y: 10, gfx: "OBJ_EVENT_GFX_BOY_2", id: "LOCALID_GRIS_GWADA", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "GrisEchec_EventScript_Gwada", flag: "FLAG_TEMP_1"),
    Object(x: 21, y: 13, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_GRIS_BALAYEUR", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "GrisEchec_EventScript_Balayeur", trainer_type: "TRAINER_TYPE_NORMAL", sight: 2),
    Object(x: 19, y: 5, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_GRIS_SBIRE_TOIT", movement: "MOVEMENT_TYPE_FACE_LEFT", script: "GrisEchec_EventScript_SbireToit", trainer_type: "TRAINER_TYPE_NORMAL", sight: 3),
    Object(x: 38, y: 1, gfx: "OBJ_EVENT_GFX_NINJA_BOY", id: "LOCALID_GRIS_GARDE_S3", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "GrisEchec_EventScript_GardeS3", flag: "FLAG_TEMP_2"),
    Object(x: 32, y: 10, gfx: "OBJ_EVENT_GFX_PIKACHU", id: "LOCALID_GRIS_LAINERGIE", movement: "MOVEMENT_TYPE_FACE_RIGHT", script: "GrisEchec_EventScript_Lainergie", flag: "FLAG_TEMP_3"),
    // Gris_Echec_Sc01: the west entrance (x 1, y 10-12), VAR_SIL_STORY 22.
    Coord(x: 1, y: 10, var: "VAR_SIL_STORY", value: 22, script: "GrisEchec_Sc01"),
    Coord(x: 1, y: 11, var: "VAR_SIL_STORY", value: 22, script: "GrisEchec_Sc01"),
    Coord(x: 1, y: 12, var: "VAR_SIL_STORY", value: 22, script: "GrisEchec_Sc01"),
    // Gris_Echec_Sc06: the first step out of the arena. The door's exit step lands on (34, 10),
    // which fires no coord event; Gwada (33, 10) and the guard (35, 10) leave (34, 11) as the only way.
    Coord(x: 34, y: 11, var: "VAR_SIL_STORY", value: 27, script: "GrisEchec_Sc06"),
    Sign(x: 1, y: 9, script: "GrisEchec_EventScript_SignVille"),
    Sign(x: 36, y: 10, script: "GrisEchec_EventScript_SignArene"),
    Sign(x: 24, y: 5, script: "GrisEchec_EventScript_SignTour"),
    Sign(x: 32, y: 21, script: "GrisEchec_EventScript_SignUsine"),
    // The jammers: J1 on the Mart annex roof (Lame-Frequence, Gris_Echec_Sc02 with n = 1), J2 in the
    // plaza bin (n = 2; Gris_Echec_Poubelle first). J3 is in the factory.
    Sign(x: 17, y: 4, script: "GrisEchec_EventScript_Brouilleur1"),
    Sign(x: 20, y: 14, script: "GrisEchec_EventScript_Brouilleur2"),
    // The Iron hidden behind the Pokemon Centre.
    HiddenItem(x: 6, y: 4, item: "ITEM_IRON", flag: "FLAG_SIL_ITEM_GRIS_ECHEC_IRON"),
    // Route S2 to the west: its exit y 3-5 meets ours y 10-12. Route S3 to the north: its entry
    // x 9-10 meets our corridor x 38-39.
    Connect((dir: West, offset: 7, map: "RouteS02")),
    Connect((dir: North, offset: 29, map: "RouteS03")),
]

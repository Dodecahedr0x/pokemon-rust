// Cells: ground plan, then the buildings and props stamped over it.
[
    // Ground plan: # | ! concrete walls (General 0), . sidewalk (General 94), = street paved with
    // circuit boards (SilGrisEchec pave), o x the Place des Pions (black and white slabs), ^ v the
    // street screens on poles, s signposts (General 3).
    // The seams stay General: the cells Route S2 (west, rows 8-13, x 0-2: - is the sidewalk where
    // the street meets it) and Route S3 (north, rows 0-2, x 29-39) draw with their own secondary.
    Ascii(x: 0, y: 0, rows: [
        "######################################..",
        "|....................................!..",
        "|....................................!..",
        "|....................................!..",
        "|....................................!.!",
        "|.^..................==.s............-.!",
        "|.v..................==..............-.!",
        "|....................==..............-.!",
        "|....................==..............-.!",
        "|s-=====================================",
        "---=================================s==!",
        "---=====================================",
        "---====oxoxoxoxoxoxoxoxoxox=============",
        "|.....=xoxoxoxoxoxoxoxoxoxo=.^.........^",
        "|.....=oxoxoxoxoxoxoxoxoxox=.v.........v",
        "|.....=xoxoxoxoxoxoxoxoxoxo=...........!",
        "|.....=oxoxoxoxoxoxoxoxoxox=...........!",
        "|.....=xoxoxoxoxoxoxoxoxoxo=...........!",
        "|.....=oxoxoxoxoxoxoxoxoxox=...........!",
        "|.....======================...........!",
        "|.....=....................=...........!",
        "|.....=....................======s=====!",
        "|.^...=........^...........=......^....!",
        "|.v...=........v...........=......v....!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "|.....=....................=...........!",
        "########################################",
    ], legend: {'#': (metatile: 0, collision: 1), '|': (metatile: 0, collision: 1), '!': (metatile: 0, collision: 1), '.': (metatile: 94, collision: 0), '-': (metatile: 94, collision: 0), '=': (metatile: 659, collision: 0), 'o': (metatile: 660, collision: 0), 'x': (metatile: 661, collision: 0), '^': (metatile: 654, collision: 0), 'v': (metatile: 655, collision: 1), 's': (metatile: 3, collision: 1)}),
    // The buildings: SilGrisEchec's stamps (games/silice/gfx/SilGrisEchec.ron, original art).
    // Concrete blocks with screens of grey snow (4x4).
    Stamp(x: 1, y: 0, name: "SilGrisEchec_immeuble"),
    Stamp(x: 8, y: 0, name: "SilGrisEchec_immeuble"),
    // Pokemon Centre x 4-6, y 5-8, door (5, 8); Mart x 10-12, y 5-8, door (11, 8).
    Stamp(x: 4, y: 5, name: "SilGrisEchec_centre"),
    Stamp(x: 10, y: 5, name: "SilGrisEchec_boutique"),
    // The Mart annex x 14-18, y 3-7: its roof (15-17, 4-5) is reached by the ladder (15, 6-7) only.
    Stamp(x: 14, y: 3, name: "SilGrisEchec_annexe"),
    // Tour d'Observation x 20-23, y 0-4, the double door (21-22, 4).
    Stamp(x: 20, y: 0, name: "SilGrisEchec_tour"),
    // The arena, the black cube, x 32-36, y 5-9, door (34, 9) (rows 0-4 stay General: Route S3's seam).
    Stamp(x: 32, y: 5, name: "SilGrisEchec_arene"),
    // Block west of the plaza, x 1-4, y 14-17 (below Route S2's seam): the Enfant (6, 15) watches its screen.
    Stamp(x: 1, y: 14, name: "SilGrisEchec_immeuble"),
    // The closed factory x 27-33, y 17-20, door (30, 20).
    Stamp(x: 27, y: 17, name: "SilGrisEchec_usine"),
    // The giant black pawn of the south square, x 15-16, y 25-26.
    Stamp(x: 15, y: 25, name: "SilGrisEchec_pion"),
    Stamp(x: 8, y: 24, name: "SilGrisEchec_immeuble"),
    Stamp(x: 20, y: 24, name: "SilGrisEchec_immeuble"),
    // The south-east blocks (no interior).
    Stamp(x: 30, y: 23, name: "SilGrisEchec_immeuble"),
    Stamp(x: 35, y: 26, name: "SilGrisEchec_immeuble"),
    // J1, the rooftop jammer (Gris_Echec_Sc02) on the annex roof (j1_hs once cut, GrisEchec_OnLoad);
    // J2 hidden in the plaza bin, on a white slab.
    Stamp(x: 17, y: 4, name: "SilGrisEchec_j1"),
    Stamp(x: 20, y: 14, name: "SilGrisEchec_poubelle_case"),
    // The Sector Gamma barrier: (37, 1) in the source, (39, 3) here (below Route S3's seam rows),
    // its guard on (38, 3); opened by Gris_Echec_Sc06.
    Stamp(x: 39, y: 3, name: "SilGrisEchec_barriere"),
]

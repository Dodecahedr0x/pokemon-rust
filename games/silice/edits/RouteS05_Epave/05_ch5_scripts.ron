// SIL3 Ch5 scripts: the map changes the Chapter 5 scripts need.
[
    // The hidden-item fallback (as Ch0-Ch2): the engine ignores BgKind::HiddenItem (the M9 finding of
    // "SIL1 Task F as built"), so the hidden item is a sign running hidden_item. To restore once the
    // engine picks hidden items up: Replace(index: 1, event: Bg((x: 11, y: 3, elevation: 0, kind: HiddenItem(item: "ITEM_REVIVE", flag: "FLAG_SIL_ITEM_ROUTE_S05_EPAVE_RAPPEL")))).
    Replace(index: 1, event: Bg((x: 11, y: 3, elevation: 0, kind: Script(facing: 0, script: Some("RouteS05_Epave_EventScript_HiddenRevive"))))),
]

[
    Replace(index: 1, event: Bg((x: 11, y: 3, elevation: 0, kind: HiddenItem(item: "ITEM_REVIVE", flag: "FLAG_SIL_ITEM_ROUTE_S05_EPAVE_RAPPEL")))),
]

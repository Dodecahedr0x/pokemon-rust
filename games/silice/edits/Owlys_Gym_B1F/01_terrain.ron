// Cells (SilOwlysGym, games/silice/gfx/SilOwlysGym.ron, original art). The first build's collisions
// and elevations stay cell for cell.
[
    // Ground plan. . the crypt's slabs (MB_CAVE), o stone tombs, & the ladder up (in the back wall),
    // # the masonry, ^ 7 9 l r the wall with its red stained glass, [ ] _ the wall rims.
    Ascii(x: 0, y: 0, rows: [
        "####################",
        "#########7^9########",
        "##7^^^^^^r&l^^^^^9##",
        "##[..............]##",
        "##[.o..........o.]##",
        "##[..............]##",
        "##[..............]##",
        "##[.....o..o.....]##",
        "##[..............]##",
        "##[..............]##",
        "##[.o..........o.]##",
        "##[..............]##",
        "##________________##",
        "####################",
    ], legend: {
        '.': (metatile: 512, collision: 0, elevation: 3),
        'o': (metatile: 564, collision: 1, elevation: 3),
        '&': (metatile: 565, collision: 0, elevation: 3),
        '#': (metatile: 544, collision: 1, elevation: 0),
        '7': (metatile: 545, collision: 1, elevation: 0),
        '9': (metatile: 545, collision: 1, elevation: 0),
        '^': (metatile: 545, collision: 1, elevation: 0),
        'l': (metatile: 545, collision: 1, elevation: 0),
        'r': (metatile: 545, collision: 1, elevation: 0),
        '[': (metatile: 546, collision: 1, elevation: 0),
        ']': (metatile: 547, collision: 1, elevation: 0),
        '_': (metatile: 548, collision: 1, elevation: 0),
    }),
]

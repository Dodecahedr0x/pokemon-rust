    // engine picks hidden items up: Replace(index: 7, event: Bg((x: 33, y: 6, elevation: 0, kind: HiddenItem(item: "ITEM_HYPER_POTION", flag: "FLAG_SIL_ITEM_S08_CACHE_1")))).
    Replace(index: 7, event: Bg((x: 33, y: 6, elevation: 0, kind: Script(facing: 0, script: Some("RouteS08_EventScript_HiddenHyperPotion"))))),
]

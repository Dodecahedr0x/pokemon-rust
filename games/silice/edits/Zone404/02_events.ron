// Header, map scripts, warps, objects, coord and bg events, connections.
[
    Header((music: "MUS_RG_ROCKET_HIDEOUT", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Warp 0: fragment 1's mat (2, 10), back to the lab's teleporter (BenouLab warp 2); also fragment 1's

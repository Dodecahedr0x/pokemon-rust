    // Manga_Square_Sc04: the groomer (Peigne de Luxe), by the pink rug.
    Object(x: 5, y: 3, gfx: "OBJ_EVENT_GFX_WOMAN_5", id: "LOCALID_MANGA_SQUARE_TOILETTEUR", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Sc04"),
    Object(x: 6, y: 5, gfx: "OBJ_EVENT_GFX_SKITTY", id: "LOCALID_MANGA_SQUARE_TOILETTEUR_SKITTY", movement: "MOVEMENT_TYPE_FACE_DOWN", script: "MangaSquare_Toiletteur_EventScript_Skitty"),

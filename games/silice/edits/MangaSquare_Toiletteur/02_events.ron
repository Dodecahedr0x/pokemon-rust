// Header, warps, objects. The town's music, as Emerald's small shops (Slateport's Fan Club plays Slateport's).
[
    Header((music: "MUS_LILYCOVE", region_map_section: "MAPSEC_NONE", cave: 0, weather: "WEATHER_NONE", map_type: "MAP_TYPE_INDOOR", allow_cycling: false, allow_escaping: false, allow_running: true, show_map_name: false, battle_scene: "MAP_BATTLE_SCENE_NORMAL")),
    // Warps 0-1: the mat, to Manga-Square's warp 4.
    Warp(x: 4, y: 8, dest_map: "MangaSquare", dest_warp: 4),

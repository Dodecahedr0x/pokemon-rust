// Chapter 7 link: the Grand Torii's north exit to Route S7 (MAP_ROUTE_S07). A warp, not a connection:
// Route S7 is Building + TrainerHill, and Gen3 draws a neighbour with the current map's tilesets. The
// exit (37, 0) is SilMangaSquare's stone steps (`sortie`, MB_NON_ANIMATED_DOOR): stepping on it warps to
// Route S7's right south mat (its warp 2), and arriving on it walks the player down to (37, 1). The
// hedge beside it (x 34-36 and 38-41 on row 0, and (41, 1) where the forest block is cut) is solid, so
// the exit is entered only from (37, 1): Manga_Square_Sc03's coord cell cannot be walked round, and the
// controleur on (37, 1) bars the exit until Sc02.
[
    Stamp(x: 37, y: 0, name: "SilMangaSquare_sortie"),
    Stamp(x: 34, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 35, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 36, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 38, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 39, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 40, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 41, y: 0, name: "SilMangaSquare_haie"),
    Stamp(x: 41, y: 1, name: "SilMangaSquare_haie"),
    Warp(x: 37, y: 0, dest_map: "RouteS07", dest_warp: 2),
    AllowReach(subject: "coords VAR_SIL_STORY=67", reason: "only warp 6's exit walk from Route S7 lands on (37, 1) without stepping on it, and Route S7 is reached only after Sc03 sets 68"),
]

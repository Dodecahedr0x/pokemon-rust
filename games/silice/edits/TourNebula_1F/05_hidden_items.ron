[
    Replace(index: 6, event: Bg((x: 21, y: 9, elevation: 0, kind: HiddenItem(item: "ITEM_MAX_ELIXIR", flag: "FLAG_SIL_ITEM_TOUR_1F_MAX_ELIXIR")))),
]

// The new game and the system ids (SIL1 Task E; format: extract::games::GameFile, loaded by
// crates/content/build/silice/game.rs). Hand-written: `cargo xtask silice import` never writes it.
(
    // Ch0 Bar_Sc01 opens the game in the Shaker: the source puts the player on the free stool in
    // front of the counter ((7, 8) in its plan); the built bar has its stools at y 4, between
    // GWADA (6, 4) and ADRIEN (9, 4), facing the counter (up).
    start: (map: "BricoBourg_Bar", x: 7, y: 4, facing: Up),
    // bible/personnages.md: the hero's default name (renamable).
    player_name: "NOOBODY",
    // Ch0 Player_House_Sc03: MAMAN gives the running shoes as a flag, not an item.
    running_flag: "FLAG_SIL_RUNNING_SHOES",
    // Gen3 ClearTempFieldEventData, minus the Union Room nurse reminder (no Union Room).
    cleared_on_map_change: [
        "FLAG_SYS_ENC_UP_ITEM",
        "FLAG_SYS_ENC_DOWN_ITEM",
        "FLAG_SYS_USE_STRENGTH",
        "FLAG_SYS_CTRL_OBJ_DELETE",
    ],
    // Append-only: a heal location's number is its index plus one.
    heal_locations: [
        // The player's bedroom, as Emerald's HEAL_LOCATION_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F
        // (4, 2). Ch0: "the house is the heal point, set_respawn on the house at the start".
        (name: "HEAL_LOCATION_SIL_BRICO_BOURG_PLAYER_HOUSE", map: "BricoBourg_PlayerHouse_2F", x: 4, y: 2),
        // Ch1: Bois-Éther's Pokémon Center ("set_respawn à l'entrée"). As Emerald's town heal
        // locations, the cell in front of its door (27, 12).
        (name: "HEAL_LOCATION_SIL_BOIS_ETHER", map: "BoisEther", x: 27, y: 13),
        // Ch2: Gris-Échec's Centre, set on entering it (GrisEchec_PokemonCenter_OnTransition).
        // As Ch1's, the cell in front of its door (5, 8).
        (name: "HEAL_LOCATION_SIL_GRIS_ECHEC", map: "GrisEchec", x: 5, y: 9),
        // Ch4: the Taverne, Port-Ressac's Center (its nurse sets it, "à la première visite").
        // The cell in front of its door (4, 7).
        (name: "HEAL_LOCATION_SIL_PORT_RESSAC", map: "PortRessac", x: 4, y: 8),
    ],
    respawn: "HEAL_LOCATION_SIL_BRICO_BOURG_PLAYER_HOUSE",
    // Ch0 Brico_Bourg_Sc03 (D-18): index 0, 1, 2 is VAR_SIL_STARTER's value. Level 5.
    starters: ["SPECIES_CHIKORITA", "SPECIES_CYNDAQUIL", "SPECIES_TOTODILE"],
    starter_level: 5,
    // Objects hidden at VAR_SIL_STORY 0 (night, in the bar).
    new_game_flags: [
        // Shown by a scene (Bar_Sc03 shows the sbires and the Mallette; Brico_Bourg_Sc01 the
        // sbire), never by the map's own scripts.
        "FLAG_SIL_HIDE_BAR_SBIRE_A",
        "FLAG_SIL_HIDE_BAR_SBIRE_B",
        "FLAG_SIL_HIDE_BAR_MALLETTE",
        "FLAG_SIL_HIDE_BRICO_SBIRE",
        // The friends wait in front of the house at VAR_SIL_STORY 3 and 4 only.
        "FLAG_SIL_HIDE_BRICO_MATHIEU",
        "FLAG_SIL_HIDE_BRICO_GWADA",
        "FLAG_SIL_HIDE_BRICO_ADRIEN",
        // The day NPCs (VAR_SIL_STORY 3 and up): BricoBourg_OnTransition clears them by day.
        "FLAG_SIL_HIDE_BRICO_LINGE",
        "FLAG_SIL_HIDE_BRICO_GAMIN",
        "FLAG_SIL_HIDE_BRICO_BRICOLEUSE",
        // Ch1 Bois-Éther (BoisEther_OnTransition owns them from VAR_SIL_STORY): Adrien waits at
        // the meeting point at VAR_SIL_STORY 10–11 only; Bois_Ether_Sc06 shows Gogo, Romain, the
        // two sbires and Mathieu for the ambush, and hides them again. The technician, the
        // barrier guard, Loïc and the Labo's Chimiste start visible.
        "FLAG_SIL_HIDE_BOIS_ETHER_ADRIEN",
        "FLAG_SIL_HIDE_BOIS_ETHER_GOGO",
        "FLAG_SIL_HIDE_BOIS_ETHER_ROMAIN",
        "FLAG_SIL_HIDE_BOIS_ETHER_SBIRE_1",
        "FLAG_SIL_HIDE_BOIS_ETHER_SBIRE_2",
        "FLAG_SIL_HIDE_BOIS_ETHER_MATHIEU",
        // Ch2 Gris-Échec. Route S2: Adrien and Gwada (RouteS02_OnTransition shows them from
        // VAR_SIL_STORY 17). Gris-Échec: Gwada at the arena (22–27), Lainergie (27), the arena
        // guard's stepped-aside copy (Gris_Echec_Sc05 swaps the two guards). The arena: the binary
        // robot and Gym2_Sc11's Gwada, Wattouat and Lainergie, shown by their scenes only.
        "FLAG_SIL_HIDE_ROUTE_S02_ADRIEN",
        "FLAG_SIL_HIDE_ROUTE_S02_GWADA",
        "FLAG_SIL_HIDE_GRIS_GWADA",
        "FLAG_SIL_HIDE_GRIS_LAINERGIE",
        "FLAG_SIL_HIDE_GRIS_GARDE_ECARTE",
        "FLAG_SIL_HIDE_GYM2_ROBOT",
        "FLAG_SIL_HIDE_GYM2_GWADA",
        "FLAG_SIL_HIDE_GYM2_WATTOUAT",
        "FLAG_SIL_HIDE_GYM2_LAINERGIE",
        // Ch3 Viber-City: Tauber and Mathieu with the cart (scene actors), the six people under
        // blankets in the Centre (from the black-out on), Gogo and Romain at the casino (from
        // VAR_SIL_STORY 32), Romain in the basement (Casino_B1F_Sc02). The Depot's Metal Coat
        // appears once Depot_Sc02 clears its flag. The Depot pair and sbire, the stand's Mathieu,
        // the dancers and the Station's sbires start visible.
        "FLAG_SIL_HIDE_VIBER_TAUBER",
        "FLAG_SIL_HIDE_VIBER_MATHIEU_CHARIOT",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ01",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ02",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ03",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ04",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ05",
        "FLAG_SIL_HIDE_VIBER_PC_PNJ06",
        "FLAG_SIL_HIDE_CASINO_GOGO",
        "FLAG_SIL_HIDE_CASINO_ROMAIN",
        "FLAG_SIL_HIDE_CASINO_B1F_ROMAIN",
        "FLAG_SIL_ITEM_DEPOT_METAL_COAT",
        // Ch6 Manga-Square. Route S6: Route_S06_Sc02's Adrien and sbires (RouteS06_OnTransition
        // shows them at VAR_SIL_STORY 60) and the randonneur (from 61). Manga-Square: Benou and
        // Adrien (shown by Manga_Square_Sc02 and Sc03; the source sets them at the start) and the
        // delivery man (MangaSquare_OnTransition, from 64). The Bibliothèque's Adrien appears when
        // Dojo_Sc01 sends him there. The Dojo's Adrien, Kimiko, her drones and the Grand Torii's
        // controleur start visible.
        "FLAG_SIL_HIDE_ROUTE_S06_ADRIEN",
        "FLAG_SIL_HIDE_ROUTE_S06_SBIRE_A",
        "FLAG_SIL_HIDE_ROUTE_S06_SBIRE_B",
        "FLAG_SIL_HIDE_ROUTE_S06_RANDONNEUR",
        "FLAG_SIL_HIDE_MANGA_SQUARE_BENOU",
        "FLAG_SIL_HIDE_MANGA_SQUARE_ADRIEN_FIN",
        "FLAG_SIL_HIDE_MANGA_SQUARE_LIVREUR",
        "FLAG_SIL_HIDE_BIBLIO_ADRIEN",
        // Ch4 Port-Ressac (the OnTransition scripts own them from VAR_SIL_STORY): Crow's four
        // passers-by and Samuel on the quay, shown by Port_Ressac_Sc02, _Sc04 and _Sc05 only; the
        // quay fight (the three pirates, the four sbires, the foreman, the three decor sbires) at
        // VAR_SIL_STORY 46 only; Gwada at the Taverne (42–47) and on the Zenith-Grog (Gym_Sc03);
        // Adrien asleep at the Taverne once FLAG_SIL_ROUTE_S04_ADRIEN is set. Adrien and his
        // Magikarp in the tunnel, the cargo and its guard, Crow's client and the gangway pirate
        // start visible.
        "FLAG_SIL_HIDE_PORT_PASSANT_1",
        "FLAG_SIL_HIDE_PORT_PASSANT_2",
        "FLAG_SIL_HIDE_PORT_PASSANT_3",
        "FLAG_SIL_HIDE_PORT_PASSANT_4",
        "FLAG_SIL_HIDE_PORT_SAMUEL",
        "FLAG_SIL_HIDE_PORT_PIRATE_1",
        "FLAG_SIL_HIDE_PORT_PIRATE_2",
        "FLAG_SIL_HIDE_PORT_PIRATE_3",
        "FLAG_SIL_HIDE_PORT_SBIRE_1",
        "FLAG_SIL_HIDE_PORT_SBIRE_2",
        "FLAG_SIL_HIDE_PORT_SBIRE_3",
        "FLAG_SIL_HIDE_PORT_SBIRE_4",
        "FLAG_SIL_HIDE_PORT_CONTREMAITRE",
        "FLAG_SIL_HIDE_PORT_DECOR_1",
        "FLAG_SIL_HIDE_PORT_DECOR_2",
        "FLAG_SIL_HIDE_PORT_DECOR_3",
        "FLAG_SIL_HIDE_PORT_GYM_GWADA",
        "FLAG_SIL_HIDE_PORT_TAVERNE_GWADA",
        "FLAG_SIL_HIDE_PORT_TAVERNE_ADRIEN",
        // Ch5 Owlys (each map's OnTransition owns them from VAR_SIL_STORY and the flags): the grunt
        // crossing the square (Owlys_Sc02 only), Mathieu on the square after the badge (from 55), the
        // East Cave's duo-scene actors (Mathieu and both drivers at 52, Owl-Justice and the Shaded
        // Feather shown by Owlys_GrotteEst_Sc01 only), Skycker's face and the gym's Mathieu
        // (Owlys_Gym_Sc01), and the silo's three Umbreon (Owlys_Entrepot_B1F_Sc01_1-3). Mathieu on the
        // square, Milo and the alley grunt, the elevator's two Watchers, masked Skycker and Lokhlass
        // start visible.
        "FLAG_SIL_HIDE_OWLYS_SBIRE_EST",
        "FLAG_SIL_HIDE_OWLYS_MATHIEU_APRES",
        "FLAG_SIL_HIDE_OWLYS_GROTTE_EST_MATHIEU",
        "FLAG_SIL_HIDE_OWLYS_GROTTE_EST_CONVOYEUR_A",
        "FLAG_SIL_HIDE_OWLYS_GROTTE_EST_CONVOYEUR_B",
        "FLAG_SIL_HIDE_OWLYS_GROTTE_EST_OWL_JUSTICE",
        "FLAG_SIL_HIDE_OWLYS_GROTTE_EST_PLUME",
        "FLAG_SIL_HIDE_OWLYS_GYM_SKYCKER_VISAGE",
        "FLAG_SIL_HIDE_OWLYS_GYM_MATHIEU",
        "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_1",
        "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_2",
        "FLAG_SIL_HIDE_OWLYS_SILO_NOCTALI_3",
        // Ch7 Reverse-City: the welcoming resident (Reverse_City_Sc01 adds and removes him),
        // Benou at the Porte Eta-Nord (Reverse_City_Sc07) and in the gym (Gym_Sc02), and the black
        // pixels Reverse leaves behind (Gym_Sc01 adds them, Gym_Sc02 removes them). Gogo, Romain,
        // the Palais guard and Reverse start visible.
        "FLAG_SIL_HIDE_REVERSE_HABITANT_ACCUEIL",
        "FLAG_SIL_HIDE_REVERSE_BENOU_PORTE",
        "FLAG_SIL_HIDE_GYM07_BENOU",
        "FLAG_SIL_HIDE_GYM07_PIXELS",
        // Ch8 Évalon (each map's OnTransition owns them from VAR_SIL_STORY): Route_S08_Sc02's pigeon
        // (80); Évalon's friends (Evalon_Sc01 at 80–81, Evalon_Sc07 at 83; Mathieu keeps the
        // source's FLAG_SIL_HIDE_EVALON_AMIS, which Evalon_Sc09 sets for good), the Scribe (80–81),
        // and Evalon_Sc07's Gogo, Romain and three sbires (the source sets
        // FLAG_SIL_HIDE_EVALON_GOGO_ROMAIN by default); the friends at the Taverne (82–83).
        // Plume-d'Argent, the south-east path's guard and the gym's trapped chest start visible.
        "FLAG_SIL_HIDE_S08_PIGEON",
        "FLAG_SIL_HIDE_EVALON_AMIS",
        "FLAG_SIL_HIDE_EVALON_ADRIEN",
        "FLAG_SIL_HIDE_EVALON_GWADA",
        "FLAG_SIL_HIDE_EVALON_SCRIBE",
        "FLAG_SIL_HIDE_EVALON_GOGO_ROMAIN",
        "FLAG_SIL_HIDE_EVALON_ROMAIN",
        "FLAG_SIL_HIDE_EVALON_SBIRE_1",
        "FLAG_SIL_HIDE_EVALON_SBIRE_2",
        "FLAG_SIL_HIDE_EVALON_SBIRE_3",
        "FLAG_SIL_HIDE_EVALON_TAVERNE_MATHIEU",
        "FLAG_SIL_HIDE_EVALON_TAVERNE_ADRIEN",
        "FLAG_SIL_HIDE_EVALON_TAVERNE_GWADA",
    ],
    new_game_vars: [],
)
